<%
  const u = typeof hubUser !== 'undefined' ? hubUser : null;
%>
<% if (typeof hubMode !== 'undefined' && hubMode && u) { %>
<header class="hub-chrome">
  <div class="hub-chrome-inner">
    <a href="/" class="hub-chrome-brand">
      <img src="/hub-assets/logo-exito.png" alt="" class="hub-chrome-logo" width="36" height="36" onerror="this.style.display='none'" />
      <div>
        <p class="hub-eyebrow">Êxito Contabilidade</p>
        <strong>EXITO HUB</strong>
      </div>
    </a>
    <nav class="hub-chrome-nav" aria-label="Módulos">
      <a href="/" class="hub-nav-link">Início</a>
      <% if (u.canFolha) { %><a href="/folha/modulos" class="hub-nav-link is-active">Folha</a><% } %>
      <% if (u.canConci) { %><a href="/conci/" class="hub-nav-link">Conciliação</a><% } %>
      <% if (u.canNcm) { %><a href="/ncm/" class="hub-nav-link">NCM</a><% } %>
      <% if (u.isAdmin) { %><a href="/admin/usuarios" class="hub-nav-link">Usuários</a><% } %>
    </nav>
    <div class="hub-chrome-user">
      <span class="hub-user-name"><%= u.displayName || u.username %></span>
      <form method="post" action="/logout" class="hub-inline">
        <button type="submit" class="hub-nav-link hub-nav-btn">Sair</button>
      </form>
    </div>
  </div>
</header>
<% } %>

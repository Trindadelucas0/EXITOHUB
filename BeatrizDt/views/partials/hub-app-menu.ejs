<%
  const userForMenu = (typeof menuUser !== 'undefined' && menuUser)
    ? menuUser
    : (typeof hubUser !== 'undefined' ? hubUser : null);
  const menuCurrent = typeof current !== 'undefined' ? current : '';
  const showHome = typeof showHomeLink === 'undefined' ? true : Boolean(showHomeLink);
  const departments = (typeof hubMenu !== 'undefined' && Array.isArray(hubMenu))
    ? hubMenu
    : [];
%>
<button
  type="button"
  class="hub-menu-btn"
  id="hub-menu-btn"
  aria-expanded="false"
  aria-controls="hub-app-menu"
  aria-label="Abrir menu de sistemas"
>
  <span class="hub-menu-btn__bars" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
  </span>
</button>

<div class="hub-menu-overlay" id="hub-menu-overlay" hidden></div>

<aside
  class="hub-menu-drawer"
  id="hub-app-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Sistemas do HUB"
  hidden
>
  <div class="hub-menu-drawer__head">
    <div>
      <p class="hub-menu-drawer__eyebrow">Êxito Hub</p>
      <strong class="hub-menu-drawer__title">Menu</strong>
    </div>
    <button type="button" class="hub-menu-close" id="hub-menu-close" aria-label="Fechar menu">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <nav class="hub-menu-nav" aria-label="Sistemas">
    <% if (showHome) { %>
      <a href="/" class="hub-menu-link <%= menuCurrent === 'home' ? 'is-active' : '' %>">Início</a>
    <% } %>

    <% departments.forEach(function(dept) { %>
      <% const deptOpen = dept.items.some(function(item) { return item.currentKey === menuCurrent; }); %>
      <details class="hub-menu-dept" <%= deptOpen ? 'open' : '' %>>
        <summary class="hub-menu-dept__summary"><%= dept.label %></summary>
        <div class="hub-menu-dept__items">
          <% dept.items.forEach(function(item) { %>
            <a
              href="<%= item.href %>"
              class="hub-menu-link <%= item.currentKey === menuCurrent ? 'is-active' : '' %>"
              <% if (item.external) { %>target="_blank" rel="noopener noreferrer"<% } %>
            >
              <span class="hub-menu-link__text"><%= item.label %></span>
              <% if (item.status === 'soon') { %>
                <span class="hub-menu-badge">Em breve</span>
              <% } %>
              <% if (item.external) { %>
                <span class="hub-menu-badge hub-menu-badge--ext" aria-hidden="true">↗</span>
              <% } %>
            </a>
          <% }); %>
        </div>
      </details>
    <% }); %>
  </nav>
</aside>

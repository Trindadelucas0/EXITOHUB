<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/hub-head') %>
</head>
<body class="hub-body">
  <%- include('partials/hub-chrome', { current: '', breadcrumb: 'Acesso negado' }) %>
  <main class="hub-shell-main">
    <section class="hub-empty-panel" style="text-align: left;">
      <div class="hub-alert" role="alert">
        Você não tem permissão para o módulo <strong><%= moduleName %></strong>.
      </div>
      <p style="margin-top: 1rem;"><a class="hub-btn hub-btn-primary" href="/">Voltar ao HUB</a></p>
    </section>
  </main>
  <%- include('partials/hub-chrome-end') %>
</body>
</html>

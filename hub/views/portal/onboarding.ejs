<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/hub-assets/hub.css" />
</head>
<body class="hub-body">
  <%- include('../partials/hub-chrome', { current: 'portal-onboarding' }) %>
  <main class="hub-main hub-portal-page">
    <section class="hub-card">
      <p class="hub-breadcrumb"><a href="/">Início</a> / Integração</p>
      <div class="hub-onboarding-head">
        <div>
          <h1>Integração</h1>
          <p class="hub-muted">
            <% if (track) { %><%= track.name %><% } else { %>Nenhuma trilha ativa.<% } %>
          </p>
        </div>
        <% if (total) { %>
          <p class="hub-onboarding-progress" aria-label="Progresso"><%= doneCount %> / <%= total %></p>
        <% } %>
      </div>

      <% if (total) { %>
        <div class="hub-onboarding-meter" role="progressbar"
             aria-valuenow="<%= Math.round((doneCount / total) * 100) %>"
             aria-valuemin="0" aria-valuemax="100">
          <span class="hub-onboarding-meter__bar" style="width: <%= Math.round((doneCount / total) * 100) %>%"></span>
        </div>
        <p class="hub-muted"><%= Math.round((doneCount / total) * 100) %>% concluído</p>
      <% } %>

      <% if (flash) { %><div class="hub-alert hub-alert-ok"><%= flash %></div><% } %>
      <% if (error) { %><div class="hub-alert hub-alert-error"><%= error %></div><% } %>

      <% if (hubUser.onboardingStatus === 'COMPLETED') { %>
        <p>Você já concluiu a integração.</p>
        <p><a class="hub-btn hub-btn-primary" href="/">Ir para a Home</a></p>
      <% } else if (!(steps || []).length) { %>
        <p class="hub-muted">Aguarde o administrador configurar a trilha de integração.</p>
      <% } else { %>
        <ol class="hub-onboarding-steps">
          <% steps.forEach(function (step, idx) { %>
            <li class="hub-onboarding-step<%= step.completed ? ' is-done' : '' %><%= !step.unlocked ? ' is-locked' : '' %>">
              <div class="hub-onboarding-step__main">
                <span class="hub-onboarding-step__num"><%= String(idx + 1).padStart(2, '0') %></span>
                <div>
                  <strong><%= step.title %></strong>
                  <% if (step.description) { %><p><%= step.description %></p><% } %>
                </div>
              </div>
              <div class="hub-onboarding-step__actions">
                <% if (step.completed) { %>
                  <span class="hub-pill hub-pill-ok">Concluída</span>
                <% } else if (!step.unlocked) { %>
                  <span class="hub-pill">Bloqueada</span>
                <% } else { %>
                  <% if (step.href) { %>
                    <a class="hub-btn hub-btn-ghost hub-btn-sm" href="<%= step.href %>">Abrir</a>
                  <% } %>
                  <form method="post" action="/portal/onboarding/steps/<%= step.id %>/complete">
                    <button type="submit" class="hub-btn hub-btn-primary hub-btn-sm">Marcar como concluída</button>
                  </form>
                <% } %>
              </div>
            </li>
          <% }) %>
        </ol>

        <form method="post" action="/portal/onboarding/complete" class="hub-onboarding-finish">
          <button type="submit" class="hub-btn hub-btn-primary" <%= canComplete ? '' : 'disabled' %>>
            Concluir integração
          </button>
          <% if (!canComplete) { %>
            <p class="hub-muted">Conclua todas as etapas para finalizar.</p>
          <% } %>
        </form>
      <% } %>
    </section>
  </main>
</body>
</html>

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/hub-assets/hub.css" />
</head>
<body class="hub-body">
  <%- include('../partials/hub-chrome', { current: typeof current !== 'undefined' ? current : '' }) %>
  <main class="hub-main hub-portal-page">
    <section class="hub-card">
      <p class="hub-breadcrumb"><a href="/">Início</a> / <%= pageTitle %></p>
      <h1><%= pageTitle %></h1>
      <p class="hub-muted"><%= pageLead %></p>
      <p><%= pageHint %></p>
      <p><a class="hub-btn hub-btn-primary" href="/">Voltar ao início</a></p>
    </section>
  </main>
</body>
</html>

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../partials/hub-head') %>
</head>
<body class="hub-body">
  <%- include('../partials/hub-chrome', {
    current: typeof current !== 'undefined' ? current : '',
    breadcrumb: meta.label
  }) %>

  <main class="hub-shell-main">
    <div class="hub-area-page">
      <p class="hub-breadcrumb hub-area-page__crumb">
        <a href="/">Início</a> / <%= meta.label %>
      </p>

      <header class="hub-area-page__header">
        <h1><%= meta.label %></h1>
        <p>
          <% if (meta.slug === 'videos') { %>
            Assista o vídeo nesta página — clique em play no player abaixo sem sair do HUB.
          <% } else if (meta.slug === 'pops') { %>
            Abra o procedimento nesta página — visualize abaixo sem sair do HUB.
          <% } else { %>
            <%= meta.description %>
          <% } %>
        </p>
      </header>

      <% if (flash) { %><div class="hub-alert hub-alert-ok"><%= flash %></div><% } %>
      <% if (error) { %><div class="hub-alert hub-alert-error"><%= error %></div><% } %>

      <% if (!(items || []).length) { %>
        <div class="hub-empty-panel">
          <span class="material-symbols-outlined" aria-hidden="true" style="font-size: 2.5rem; color: var(--exito-muted);">inventory_2</span>
          <h3><%= meta.slug === 'pops' ? 'Nenhum procedimento encontrado' : 'Nenhum item disponível' %></h3>
          <p class="hub-muted"><%= typeof emptyMessage !== 'undefined' && emptyMessage ? emptyMessage : 'Nenhum item disponível no momento.' %></p>
        </div>
      <% } else if (meta.slug === 'videos') { %>
        <%
          const selectedId = typeof selectedVideoId !== 'undefined' ? selectedVideoId : null;
          let featured = items[0];
          let featuredIdx = 0;
          if (selectedId) {
            const foundIdx = items.findIndex(function (it) { return String(it.id) === String(selectedId); });
            if (foundIdx >= 0) {
              featured = items[foundIdx];
              featuredIdx = foundIdx;
            }
          }
          const modLabel = 'MOD-' + String(featuredIdx + 1).padStart(2, '0');
        %>
        <% if (featured && featured.youtube_embed_url) { %>
          <article class="hub-video-feature">
            <div class="hub-video-feature__bar">
              <div class="hub-video-feature__bar-left">
                <span class="hub-video-feature__mod"><%= modLabel %></span>
                <span class="hub-video-feature__label">
                  <% if (featured.is_onboarding_required) { %>
                    Vídeo obrigatório
                  <% } else if (featured.department) { %>
                    <%= featured.department %>
                  <% } else { %>
                    Vídeo de integração
                  <% } %>
                </span>
              </div>
            </div>
            <div class="hub-video-feature__player">
              <iframe
                src="<%= featured.youtube_embed_url %>"
                title="<%= featured.title %>"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                referrerpolicy="strict-origin-when-cross-origin"
              ></iframe>
            </div>
            <div class="hub-video-feature__meta">
              <div class="hub-video-feature__meta-row">
                <div>
                  <h2><%= featured.title %></h2>
                  <p class="hub-video-feature__meta-sub">
                    <% if (featured.department) { %><%= featured.department %><% } %>
                    <% if (featured.version) { %><%= featured.department ? ' · ' : '' %>v<%= featured.version %><% } %>
                    <% if (featured.category) { %><%= (featured.department || featured.version) ? ' · ' : '' %><%= featured.category %><% } %>
                  </p>
                </div>
              </div>
              <% if (featured.description) { %>
                <p class="hub-video-feature__desc"><%= featured.description %></p>
              <% } %>
            </div>
          </article>
        <% } else if (featured) { %>
          <div class="hub-alert">Link do YouTube inválido ou ausente. Peça ao administrador para atualizar.</div>
        <% } %>

        <section class="hub-video-playlist" aria-label="Lista de vídeos">
          <div class="hub-video-playlist__head">
            <div>
              <h3>Trilha completa de vídeos de integração</h3>
              <p>Selecione um vídeo para assistir nesta página.</p>
            </div>
            <span class="hub-video-playlist__total">
              Total: <%= items.length %> vídeo<%= items.length === 1 ? '' : 's' %>
            </span>
          </div>
          <div class="hub-video-playlist__grid">
            <% items.forEach(function (item, idx) { %>
              <a
                class="hub-video-playlist__card<%= featured && String(featured.id) === String(item.id) ? ' is-active' : '' %>"
                href="/portal/videos?v=<%= item.id %>"
              >
                <span class="hub-video-playlist__num">MÓDULO <%= String(idx + 1).padStart(2, '0') %></span>
                <strong><%= item.title %></strong>
                <% if (item.description) { %>
                  <span class="hub-video-playlist__card-desc"><%= item.description %></span>
                <% } %>
                <span class="hub-video-playlist__status">
                  <%= featured && String(featured.id) === String(item.id) ? 'Assistindo' : 'Disponível' %>
                </span>
              </a>
            <% }) %>
            <a class="hub-video-playlist__card hub-video-playlist__cta-card" href="/portal/pops">
              <span class="hub-video-playlist__num">Documentação</span>
              <strong>Prefere ler os manuais?</strong>
              <span class="hub-video-playlist__card-desc">Acesse a biblioteca de POPs com passos detalhados em texto e PDF.</span>
              <span class="hub-video-playlist__status">Explorar POPs →</span>
            </a>
          </div>
        </section>
      <% } else if (meta.slug === 'pops') { %>
        <%
          const selectedPop = typeof selectedPopId !== 'undefined' ? selectedPopId : null;
          let featuredPop = items[0];
          let featuredPopIdx = 0;
          if (selectedPop) {
            const foundPopIdx = items.findIndex(function (it) { return String(it.id) === String(selectedPop); });
            if (foundPopIdx >= 0) {
              featuredPop = items[foundPopIdx];
              featuredPopIdx = foundPopIdx;
            }
          }
          const popLabel = 'POP-' + String(featuredPopIdx + 1).padStart(2, '0');
          const popMime = String(featuredPop.file_mime || '').toLowerCase();
          const popIsPdf = popMime === 'application/pdf' && featuredPop.file_url;
          const popIsImage = !!featuredPop.is_image && featuredPop.file_url;
          const popIsYoutube = !!featuredPop.youtube_embed_url;
          const popCanWatchInApp = popIsYoutube || popIsPdf || popIsImage;
        %>
        <article class="hub-video-feature">
          <div class="hub-video-feature__bar">
            <div class="hub-video-feature__bar-left">
              <span class="hub-video-feature__mod"><%= popLabel %></span>
              <span class="hub-video-feature__label">
                <% if (featuredPop.is_onboarding_required) { %>
                  Procedimento obrigatório
                <% } else if (featuredPop.department) { %>
                  <%= featuredPop.department %>
                <% } else { %>
                  POP da empresa
                <% } %>
              </span>
            </div>
          </div>
          <div class="hub-video-feature__player hub-pop-feature__viewer<%= popIsImage ? ' hub-pop-feature__viewer--image' : '' %><%= !popCanWatchInApp ? ' hub-pop-feature__viewer--empty' : '' %>">
            <% if (popIsYoutube) { %>
              <iframe
                src="<%= featuredPop.youtube_embed_url %>"
                title="<%= featuredPop.title %>"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                referrerpolicy="strict-origin-when-cross-origin"
              ></iframe>
            <% } else if (popIsPdf) { %>
              <iframe
                src="<%= featuredPop.file_url %>"
                title="<%= featuredPop.title %>"
                loading="lazy"
              ></iframe>
            <% } else if (popIsImage) { %>
              <img src="<%= featuredPop.file_url %>" alt="<%= featuredPop.title %>" loading="lazy" />
            <% } else { %>
              <div class="hub-pop-feature__fallback">
                <span class="material-symbols-outlined" aria-hidden="true">menu_book</span>
                <p>Este procedimento ainda não pode ser aberto nesta página.</p>
                <p class="hub-muted" style="margin: 0;">Peça ao administrador para anexar um PDF/imagem ou um link do YouTube.</p>
              </div>
            <% } %>
          </div>
          <div class="hub-video-feature__meta">
            <div class="hub-video-feature__meta-row">
              <div>
                <h2><%= featuredPop.title %></h2>
                <p class="hub-video-feature__meta-sub">
                  <% if (featuredPop.department) { %><%= featuredPop.department %><% } %>
                  <% if (featuredPop.version) { %><%= featuredPop.department ? ' · ' : '' %>v<%= featuredPop.version %><% } %>
                  <% if (featuredPop.category) { %><%= (featuredPop.department || featuredPop.version) ? ' · ' : '' %><%= featuredPop.category %><% } %>
                </p>
              </div>
            </div>
            <% if (featuredPop.description) { %>
              <p class="hub-video-feature__desc"><%= featuredPop.description %></p>
            <% } %>
          </div>
        </article>

        <div class="hub-area-toolbar" data-pop-filter>
          <label class="hub-field-search">
            <span class="visually-hidden">Buscar POPs</span>
            <span class="material-symbols-outlined" aria-hidden="true">search</span>
            <input type="search" id="pop-search" placeholder="Buscar por título, departamento ou palavra-chave..." autocomplete="off" />
          </label>
          <label>
            <span class="visually-hidden">Filtrar por departamento</span>
            <select id="pop-dept" aria-label="Filtrar por departamento">
              <option value="">Todos os departamentos</option>
              <%
                const depts = [];
                items.forEach(function (it) {
                  if (it.department && depts.indexOf(it.department) === -1) depts.push(it.department);
                });
                depts.sort();
                depts.forEach(function (d) { %>
                  <option value="<%= d %>"><%= d %></option>
                <% });
              %>
            </select>
          </label>
        </div>

        <section class="hub-video-playlist" aria-label="Lista de POPs">
          <div class="hub-video-playlist__head">
            <div>
              <h3>Trilha completa de POPs da empresa</h3>
              <p>Selecione um procedimento para visualizar nesta página.</p>
            </div>
            <span class="hub-video-playlist__total">
              Total: <%= items.length %> POP<%= items.length === 1 ? '' : 's' %>
            </span>
          </div>
          <div class="hub-video-playlist__grid" data-item-list>
            <% items.forEach(function (item, idx) { %>
              <a
                class="hub-video-playlist__card<%= featuredPop && String(featuredPop.id) === String(item.id) ? ' is-active' : '' %>"
                href="/portal/pops?p=<%= item.id %>"
                data-title="<%= String(item.title || '').toLowerCase() %>"
                data-department="<%= item.department || '' %>"
                data-category="<%= item.category || '' %>"
                data-description="<%= String(item.description || '').toLowerCase() %>"
              >
                <span class="hub-video-playlist__num">POP <%= String(idx + 1).padStart(2, '0') %></span>
                <strong><%= item.title %></strong>
                <% if (item.description) { %>
                  <span class="hub-video-playlist__card-desc"><%= item.description %></span>
                <% } %>
                <span class="hub-video-playlist__status">
                  <%= featuredPop && String(featuredPop.id) === String(item.id) ? 'Visualizando' : 'Disponível' %>
                </span>
              </a>
            <% }) %>
            <a class="hub-video-playlist__card hub-video-playlist__cta-card" href="/portal/videos">
              <span class="hub-video-playlist__num">Vídeos</span>
              <strong>Prefere assistir?</strong>
              <span class="hub-video-playlist__card-desc">Veja a trilha de vídeos de integração com player embutido no HUB.</span>
              <span class="hub-video-playlist__status">Explorar vídeos →</span>
            </a>
          </div>
        </section>
        <div class="hub-empty-panel" data-filter-empty hidden aria-hidden="true" style="display: none;">
          <span class="material-symbols-outlined" aria-hidden="true" style="font-size: 2rem; color: var(--exito-muted);">manage_search</span>
          <h3>Nenhum procedimento encontrado</h3>
          <p class="hub-muted">Não localizamos itens com os filtros selecionados. Ajuste a busca ou o departamento.</p>
          <button type="button" class="hub-btn hub-btn-ghost" data-clear-filters>Limpar filtros</button>
        </div>
      <% } else { %>
        <ul class="hub-area-item-grid" data-item-list>
          <% items.forEach(function (item) { %>
            <li>
              <% if (item.href) { %>
                <a
                  class="hub-area-item-card"
                  href="<%= item.href %>"
                  <% if (item.file_url || item.external_url) { %>target="_blank" rel="noopener noreferrer"<% } %>
                >
                  <span class="hub-area-item-card__media<%= item.is_image ? ' hub-area-item-card__media--photo' : '' %>">
                    <% if (item.cover_url) { %>
                      <img src="<%= item.cover_url %>" alt="" width="280" height="180" loading="lazy" />
                    <% } else { %>
                      <span class="hub-area-item-card__media-fallback">
                        <%- include('../partials/hub-menu-icon', { iconName: meta.icon }) %>
                      </span>
                    <% } %>
                  </span>
                  <strong><%= item.title %></strong>
                  <% if (item.description) { %><span class="hub-muted" style="font-size: 0.8125rem;"><%= item.description %></span><% } %>
                  <span class="hub-muted" style="font-size: 0.75rem; display: flex; flex-wrap: wrap; gap: 0.5rem;">
                    <% if (item.department) { %><span><%= item.department %></span><% } %>
                    <% if (item.version) { %><span>v<%= item.version %></span><% } %>
                    <% if (item.category) { %><span><%= item.category %></span><% } %>
                  </span>
                </a>
              <% } else { %>
                <div class="hub-area-item-card">
                  <strong><%= item.title %></strong>
                  <% if (item.description) { %><span class="hub-muted" style="font-size: 0.8125rem;"><%= item.description %></span><% } %>
                </div>
              <% } %>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </main>

  <%- include('../partials/hub-chrome-end') %>
  <% if (meta.slug === 'pops') { %>
  <script>
    (function () {
      var search = document.getElementById('pop-search');
      var dept = document.getElementById('pop-dept');
      var list = document.querySelector('[data-item-list]');
      var empty = document.querySelector('[data-filter-empty]');
      var clearBtn = document.querySelector('[data-clear-filters]');
      if (!search || !list) return;

      function setEmptyVisible(show) {
        if (!empty) return;
        empty.hidden = !show;
        empty.setAttribute('aria-hidden', show ? 'false' : 'true');
        empty.style.display = show ? '' : 'none';
      }

      function apply() {
        var q = (search.value || '').trim().toLowerCase();
        var d = dept ? dept.value : '';
        var visible = 0;
        list.querySelectorAll('[data-title]').forEach(function (card) {
          var title = card.getAttribute('data-title') || '';
          var description = card.getAttribute('data-description') || '';
          var category = (card.getAttribute('data-category') || '').toLowerCase();
          var department = card.getAttribute('data-department') || '';
          var matchQ = !q || title.indexOf(q) !== -1 || description.indexOf(q) !== -1 || category.indexOf(q) !== -1 || department.toLowerCase().indexOf(q) !== -1;
          var matchD = !d || department === d;
          var show = matchQ && matchD;
          card.hidden = !show;
          if (show) visible += 1;
        });
        setEmptyVisible(visible === 0);
      }

      search.addEventListener('input', apply);
      if (dept) dept.addEventListener('change', apply);
      if (clearBtn) {
        clearBtn.addEventListener('click', function () {
          search.value = '';
          if (dept) dept.value = '';
          apply();
        });
      }
      setEmptyVisible(false);
    })();
  </script>
  <% } %>
</body>
</html>

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/hub-head') %>
</head>
<body class="hub-body">
  <%- include('partials/hub-chrome', { current: 'home', breadcrumb: 'Portal Corporativo' }) %>

  <main class="hub-shell-main">
    <div class="hub-home hub-home--portal">
      <div class="hub-portal">
        <% if (flash) { %><div class="hub-alert hub-alert-ok" role="status"><%= flash %></div><% } %>
        <% if (error) { %><div class="hub-alert hub-alert-error" role="alert"><%= error %></div><% } %>

        <% if (needsOnboarding) { %>
          <aside class="hub-onboarding-banner hub-onboarding-banner--rich" aria-label="Integração pendente">
            <div class="hub-onboarding-banner__copy">
              <div class="hub-onboarding-banner__eyebrow-row">
                <span class="hub-onboarding-chip">
                  <span class="material-symbols-outlined" aria-hidden="true">schedule</span>
                  Onboarding em Curso
                </span>
                <% if (onboardingProgress && onboardingProgress.trackName) { %>
                  <span class="hub-muted" style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem;">
                    <%= onboardingProgress.trackName %>
                  </span>
                <% } %>
              </div>
              <h2 class="hub-onboarding-banner__title">BEM-VINDO AO ÊXITO</h2>
              <p class="hub-muted" style="margin: 0.35rem 0 0;">
                Vamos apresentar a nossa empresa, cultura, ferramentas operacionais e processos essenciais para o seu dia a dia.
              </p>
              <% if (onboardingProgress && onboardingProgress.total) { %>
                <div class="hub-onboarding-meter" role="progressbar"
                     aria-valuenow="<%= onboardingProgress.percent %>"
                     aria-valuemin="0" aria-valuemax="100"
                     aria-label="Progresso da integração"
                     style="margin-top: 1rem; max-width: 28rem;">
                  <span class="hub-onboarding-meter__bar" style="width: <%= onboardingProgress.percent %>%"></span>
                </div>
                <p class="hub-muted" style="margin: 0.35rem 0 0; display: flex; justify-content: space-between; max-width: 28rem; font-size: 0.75rem;">
                  <span style="color: var(--exito-green); font-weight: 600;">
                    <%= onboardingProgress.doneCount %> de <%= onboardingProgress.total %> etapas concluídas
                  </span>
                  <strong><%= onboardingProgress.percent %>%</strong>
                </p>
              <% } else { %>
                <p class="hub-muted" style="margin-top: 0.75rem;">Conheça os conteúdos do portal e conclua a trilha de integração.</p>
              <% } %>
            </div>
            <div class="hub-onboarding-banner__actions">
              <a class="hub-btn hub-btn-ghost" href="#areas">
                Ver checklist
                <span class="material-symbols-outlined" aria-hidden="true" style="font-size: 1rem;">checklist</span>
              </a>
              <a class="hub-btn hub-btn-primary" href="/portal/onboarding">
                Continuar integração
                <span class="material-symbols-outlined" aria-hidden="true" style="font-size: 1rem;">arrow_forward</span>
              </a>
            </div>
          </aside>
        <% } %>

        <% if (needsOnboarding) { %>
          <header class="hub-portal-welcome hub-portal-welcome--hero">
            <div>
              <p class="hub-portal-welcome__meta">
                Painel do Colaborador
                <% if (hubUser.department) { %>
                  <span aria-hidden="true">·</span>
                  <span class="is-primary"><%= hubUser.department %></span>
                <% } %>
              </p>
              <h1><%= greeting %></h1>
              <p>Tudo o que você precisa para trabalhar com autonomia e excelência no Êxito HUB.</p>
            </div>
          </header>
        <% } else { %>
          <header class="hub-portal-welcome hub-portal-welcome--card">
            <div class="hub-portal-welcome--hero" style="margin: 0;">
              <div>
                <p class="hub-portal-welcome__meta">
                  <span class="hub-onboarding-chip" style="background: var(--exito-green-hover);">Rotina Ativa</span>
                  Painel Operacional
                </p>
                <h1><%= greeting %></h1>
                <p>Tudo o que você precisa para trabalhar no Êxito.</p>
              </div>
              <div class="hub-portal-welcome__date hub-muted">
                <span class="material-symbols-outlined" aria-hidden="true">calendar_today</span>
                <span>
                  <span class="hub-portal-welcome__date-kicker">Hoje</span>
                  <strong id="hub-live-date"></strong>
                </span>
              </div>
            </div>
          </header>
        <% } %>

        <% if (!hubUser.canFolha && !hubUser.canConci && !hubUser.canNcm && !hubUser.isAdmin) { %>
          <div class="hub-alert">Nenhum módulo liberado. Peça ao administrador do HUB.</div>
        <% } %>

        <% if (needsOnboarding) { %>
          <section class="hub-portal-section" id="areas" aria-label="Áreas de integração">
            <div class="hub-portal-section-head">
              <h3>Módulos de Integração &amp; Conhecimento</h3>
              <span class="hub-muted" style="font-size: 0.875rem;">Selecione para navegar pelos materiais</span>
            </div>
            <div class="hub-portal-cards hub-portal-cards--icons">
              <% (cards || []).forEach(function (card) { %>
                <a class="hub-portal-card hub-portal-card--icon" href="<%= card.route %>">
                  <div class="hub-portal-card__top">
                    <span class="hub-portal-card__icon-box" aria-hidden="true">
                      <%- include('partials/hub-menu-icon', { iconName: card.icon }) %>
                    </span>
                    <% if (card.itemCount) { %>
                      <span class="hub-portal-card__tag"><%= card.itemCount %> item<%= card.itemCount === 1 ? '' : 's' %></span>
                    <% } else { %>
                      <span class="hub-portal-card__tag">Área</span>
                    <% } %>
                  </div>
                  <div>
                    <strong><%= card.label %></strong>
                    <span class="hub-portal-card__desc"><%= card.description %></span>
                  </div>
                  <div class="hub-portal-card__foot">
                    <span><%= card.short || card.label %></span>
                    <span class="hub-portal-card__cta">Acessar →</span>
                  </div>
                </a>
              <% }) %>
            </div>
          </section>
        <% } else { %>
          <%- include('partials/hub-portal-quick-bar', { quickCards: quickCards || [] }) %>
        <% } %>

        <section class="hub-portal-section hub-portal-section--contents" aria-labelledby="conteudos-titulo">
          <% if (!(contents || []).length) { %>
            <div class="hub-carousel hub-carousel--split hub-carousel--empty">
              <div class="hub-carousel__toolbar">
                <h2 id="conteudos-titulo" class="hub-portal-section__title hub-carousel__title">
                  <span class="material-symbols-outlined" aria-hidden="true">auto_stories</span>
                  Conteúdos Êxito
                </h2>
              </div>
              <p class="hub-muted hub-portal-empty"><%= (emptyStates && emptyStates.contents) || 'Em breve, novidades do Êxito.' %></p>
            </div>
          <% } else { %>
            <div class="hub-carousel hub-carousel--split" data-carousel data-autoplay="6000">
              <div class="hub-carousel__toolbar">
                <h2 id="conteudos-titulo" class="hub-portal-section__title hub-carousel__title">
                  <span class="material-symbols-outlined" aria-hidden="true">auto_stories</span>
                  Conteúdos Êxito
                </h2>
                <div class="hub-carousel__toolbar-nav">
                  <button type="button" class="hub-carousel__nav hub-carousel__nav--prev" data-carousel-prev aria-label="Anterior">
                    <span class="material-symbols-outlined">chevron_left</span>
                  </button>
                  <button type="button" class="hub-carousel__nav hub-carousel__nav--next" data-carousel-next aria-label="Próximo">
                    <span class="material-symbols-outlined">chevron_right</span>
                  </button>
                </div>
              </div>
              <div class="hub-carousel__track" data-carousel-track>
                <% contents.forEach(function (item, idx) { %>
                  <% if (item.href) { %>
                  <a
                    class="hub-carousel__slide<%= idx === 0 ? ' is-active' : '' %>"
                    data-carousel-slide
                    href="<%= item.href %>"
                    <% if (item.target_type === 'external') { %>target="_blank" rel="noopener noreferrer"<% } %>
                  >
                    <div class="hub-carousel__media">
                      <% if (item.image_url) { %>
                        <img src="<%= item.image_url %>" alt="" width="640" height="360" loading="lazy" />
                      <% } %>
                    </div>
                    <div class="hub-carousel__caption">
                      <% if (item.category) { %>
                        <span class="hub-portal-card__tag hub-portal-card__tag--accent"><%= item.category %></span>
                      <% } %>
                      <strong><%= item.title %></strong>
                      <% if (item.description) { %><span><%= item.description %></span><% } %>
                    </div>
                  </a>
                  <% } else { %>
                  <div class="hub-carousel__slide<%= idx === 0 ? ' is-active' : '' %>" data-carousel-slide>
                    <div class="hub-carousel__media">
                      <% if (item.image_url) { %>
                        <img src="<%= item.image_url %>" alt="" width="640" height="360" loading="lazy" />
                      <% } %>
                    </div>
                    <div class="hub-carousel__caption">
                      <% if (item.category) { %>
                        <span class="hub-portal-card__tag hub-portal-card__tag--accent"><%= item.category %></span>
                      <% } %>
                      <strong><%= item.title %></strong>
                      <% if (item.description) { %><span><%= item.description %></span><% } %>
                    </div>
                  </div>
                  <% } %>
                <% }) %>
              </div>
              <div class="hub-carousel__dots" data-carousel-dots role="tablist" aria-label="Slides"></div>
            </div>
          <% } %>
        </section>

        <section class="hub-home-feed" aria-label="Acontece no Êxito">
          <article class="hub-home-feed__panel">
            <div class="hub-home-feed__head">
              <h2 class="hub-home-feed__title">
                <span class="material-symbols-outlined" aria-hidden="true">notifications_active</span>
                Comunicados
              </h2>
              <a class="hub-home-feed__link" href="/portal/comunicados">Ver todos →</a>
            </div>
            <% if (!(typeof announcements !== 'undefined' && announcements && announcements.length)) { %>
              <div class="hub-home-feed__empty">
                <span class="hub-home-feed__empty-icon" aria-hidden="true">
                  <span class="material-symbols-outlined">mark_email_read</span>
                </span>
                <p class="hub-home-feed__empty-title"><%= (emptyStates && emptyStates.announcements) || 'Nenhum novo comunicado no momento.' %></p>
                <p class="hub-home-feed__empty-text"><%= (emptyStates && emptyStates.announcementsSupport) || '' %></p>
              </div>
            <% } else { %>
              <ul class="hub-home-feed__list">
                <% announcements.forEach(function (item) { %>
                  <li class="hub-home-feed__row">
                    <strong class="hub-home-feed__row-title"><%= item.title %></strong>
                    <% if (item.published_at) { %>
                      <time class="hub-home-feed__row-meta" datetime="<%= new Date(item.published_at).toISOString() %>">
                        <%= new Intl.DateTimeFormat('pt-BR', {
                          day: 'numeric', month: 'short',
                          timeZone: 'America/Sao_Paulo'
                        }).format(new Date(item.published_at)) %>
                      </time>
                    <% } %>
                    <% if (item.body) { %>
                      <p class="hub-home-feed__row-text"><%= item.body %></p>
                    <% } %>
                  </li>
                <% }) %>
              </ul>
            <% } %>
            <div class="hub-home-feed__foot">
              <span>Canal de transmissão interna</span>
            </div>
          </article>
          <article class="hub-home-feed__panel">
            <div class="hub-home-feed__head">
              <h2 class="hub-home-feed__title">
                <span class="material-symbols-outlined" aria-hidden="true">event_available</span>
                Próximos eventos
              </h2>
              <a class="hub-home-feed__link" href="/portal/eventos">Ver todos →</a>
            </div>
            <% if (!(typeof events !== 'undefined' && events && events.length)) { %>
              <div class="hub-home-feed__empty">
                <span class="hub-home-feed__empty-icon" aria-hidden="true">
                  <span class="material-symbols-outlined">event_busy</span>
                </span>
                <p class="hub-home-feed__empty-title"><%= (emptyStates && emptyStates.events) || 'Nenhum evento próximo agendado.' %></p>
                <p class="hub-home-feed__empty-text"><%= (emptyStates && emptyStates.eventsSupport) || '' %></p>
              </div>
            <% } else { %>
              <ul class="hub-home-feed__list">
                <% events.forEach(function (item) { %>
                  <li class="hub-home-feed__row">
                    <strong class="hub-home-feed__row-title"><%= item.title %></strong>
                    <% if (item.starts_at) { %>
                      <time class="hub-home-feed__row-meta" datetime="<%= new Date(item.starts_at).toISOString() %>">
                        <%= new Intl.DateTimeFormat('pt-BR', {
                          weekday: 'short', day: 'numeric', month: 'short',
                          hour: '2-digit', minute: '2-digit',
                          timeZone: 'America/Sao_Paulo'
                        }).format(new Date(item.starts_at)) %>
                        <% if (item.place) { %> · <%= item.place %><% } %>
                      </time>
                    <% } else if (item.place) { %>
                      <span class="hub-home-feed__row-meta"><%= item.place %></span>
                    <% } %>
                  </li>
                <% }) %>
              </ul>
            <% } %>
            <div class="hub-home-feed__foot">
              <span>Agenda do portal</span>
            </div>
          </article>
        </section>

        <a class="hub-home-agenda" href="/portal/agenda">
          <div class="hub-home-agenda__main">
            <span class="hub-home-agenda__icon" aria-hidden="true">
              <span class="material-symbols-outlined">calendar_month</span>
            </span>
            <div>
              <div class="hub-home-agenda__title-row">
                <h2 class="hub-home-agenda__title">Agenda Êxito</h2>
                <span class="hub-home-agenda__badge">Semanal</span>
              </div>
              <% if (typeof nextEvent !== 'undefined' && nextEvent) { %>
                <p class="hub-home-agenda__desc">
                  Próxima: <%= nextEvent.title %>
                  <% if (nextEvent.starts_at) { %>
                    · <%= new Intl.DateTimeFormat('pt-BR', {
                      weekday: 'short', day: 'numeric', month: 'short',
                      hour: '2-digit', minute: '2-digit',
                      timeZone: 'America/Sao_Paulo'
                    }).format(new Date(nextEvent.starts_at)) %>
                  <% } %>
                </p>
              <% } else { %>
                <p class="hub-home-agenda__desc"><%= (emptyStates && emptyStates.agenda) || 'Reuniões, treinamentos e eventos internos da semana.' %></p>
              <% } %>
            </div>
          </div>
          <span class="hub-home-agenda__cta">
            Ver agenda completa
            <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
          </span>
        </a>

        <section class="hub-home-bottom" aria-label="Links e contatos">
          <article class="hub-home-bottom__panel">
            <div class="hub-home-bottom__head">
              <h2 class="hub-home-feed__title">
                <span class="material-symbols-outlined" aria-hidden="true">link</span>
                Links úteis
              </h2>
            </div>
            <% if (!(links || []).length) { %>
              <div class="hub-home-feed__empty">
                <span class="hub-home-feed__empty-icon" aria-hidden="true">
                  <span class="material-symbols-outlined">link_off</span>
                </span>
                <p class="hub-home-feed__empty-title"><%= (emptyStates && emptyStates.links) || 'Nenhum link útil disponível.' %></p>
                <p class="hub-home-feed__empty-text"><%= (emptyStates && emptyStates.linksSupport) || '' %></p>
              </div>
            <% } else { %>
              <div class="hub-home-links-grid">
                <% links.forEach(function (link) { %>
                  <a
                    class="hub-home-link-tile"
                    href="<%= link.url %>"
                    target="_blank"
                    rel="noopener noreferrer"
                    title="<%= link.description || link.name %>"
                  >
                    <span class="hub-home-link-tile__main">
                      <span class="material-symbols-outlined" aria-hidden="true"><%= link.icon || 'link' %></span>
                      <span class="hub-home-link-tile__label"><%= link.name %></span>
                    </span>
                    <span class="material-symbols-outlined hub-home-link-tile__ext" aria-hidden="true">north_east</span>
                  </a>
                <% }) %>
              </div>
            <% } %>
          </article>

          <article class="hub-home-bottom__panel">
            <div class="hub-home-bottom__head">
              <h2 class="hub-home-feed__title">
                <span class="material-symbols-outlined" aria-hidden="true">mobile_share</span>
                Contatos úteis
              </h2>
              <% if ((contacts || []).length && (contactDepartments || []).length) { %>
                <label class="hub-home-dept-filter">
                  <span>Departamento:</span>
                  <select id="hub-contact-dept" data-contact-filter aria-label="Filtrar contatos por departamento">
                    <option value="">Todos</option>
                    <% contactDepartments.forEach(function (d) { %>
                      <option value="<%= d %>"><%= d %></option>
                    <% }) %>
                  </select>
                </label>
              <% } %>
            </div>
            <% if (!(contacts || []).length) { %>
              <div class="hub-home-feed__empty">
                <span class="hub-home-feed__empty-icon" aria-hidden="true">
                  <span class="material-symbols-outlined">person_off</span>
                </span>
                <p class="hub-home-feed__empty-title"><%= (emptyStates && emptyStates.contacts) || 'Nenhum contato cadastrado.' %></p>
                <p class="hub-home-feed__empty-text"><%= (emptyStates && emptyStates.contactsSupport) || '' %></p>
              </div>
            <% } else { %>
              <ul class="hub-home-contacts" data-contact-list>
                <% contacts.forEach(function (c) { %>
                  <li class="hub-home-contact" data-department="<%= c.department || '' %>">
                    <div class="hub-home-contact__who">
                      <% if (c.photo_url) { %>
                        <img src="<%= c.photo_url %>" alt="" width="40" height="40" loading="lazy" />
                      <% } else { %>
                        <span class="hub-home-contact__avatar" aria-hidden="true"><%= String(c.name || '?').charAt(0).toUpperCase() %></span>
                      <% } %>
                      <div class="hub-home-contact__meta">
                        <strong><%= c.name %></strong>
                        <% if (c.role || c.department) { %>
                          <span><%= [c.role, c.department].filter(Boolean).join(' · ') %></span>
                        <% } %>
                      </div>
                    </div>
                    <% if (c.email || c.whatsapp) { %>
                      <div class="hub-home-contact__actions">
                        <% if (c.email) { %>
                          <a href="mailto:<%= c.email %>">
                            <span class="material-symbols-outlined" aria-hidden="true" style="font-size: 1rem;">email</span>
                            E-mail
                          </a>
                        <% } %>
                        <% if (c.whatsapp) { %>
                          <a class="is-whatsapp" href="https://wa.me/<%= c.whatsapp %>" target="_blank" rel="noopener noreferrer">
                            <span class="material-symbols-outlined" aria-hidden="true" style="font-size: 1rem;">chat</span>
                            WhatsApp
                          </a>
                        <% } %>
                      </div>
                    <% } %>
                  </li>
                <% }) %>
              </ul>
            <% } %>
          </article>
        </section>
      </div>
    </div>
  </main>

  <%- include('partials/hub-chrome-end') %>
  <script src="/hub-assets/hub-carousel.js"></script>
  <script>
    (function () {
      var select = document.querySelector('[data-contact-filter]');
      var list = document.querySelector('[data-contact-list]');
      if (select && list) {
        select.addEventListener('change', function () {
          var value = select.value;
          list.querySelectorAll('li').forEach(function (li) {
            var dept = li.getAttribute('data-department') || '';
            li.hidden = Boolean(value) && dept !== value;
          });
        });
      }
      var dateEl = document.getElementById('hub-live-date');
      if (dateEl) {
        dateEl.textContent = new Intl.DateTimeFormat('pt-BR', {
          weekday: 'long',
          day: 'numeric',
          month: 'long',
          timeZone: 'America/Sao_Paulo',
        }).format(new Date());
      }
    })();
  </script>
</body>
</html>

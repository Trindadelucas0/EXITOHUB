<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/hub-assets/hub.css" />
</head>
<body class="hub-body">
  <div class="hub-home">
    <section class="hub-home-top">
      <div class="hub-home-bar">
        <a href="/" class="hub-home-brand">
          <p class="hub-wordmark">Êxito</p>
          <p class="hub-kicker">HUB</p>
        </a>
        <div class="hub-home-actions">
          <%- include('partials/hub-app-menu', { menuUser: hubUser, current: 'home', showHomeLink: false }) %>
          <form method="post" action="/logout" class="hub-inline">
            <button type="submit" class="hub-btn hub-btn-ghost hub-btn-sm">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M9 21H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                <path d="M16 17l5-5-5-5M21 12H9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Sair
            </button>
          </form>
        </div>
      </div>

      <div class="hub-home-welcome">
        <h1>Bem-vindo, <%= hubUser.displayName || hubUser.username %></h1>
        <p>Abra o menu para escolher o sistema</p>
      </div>
    </section>

    <% if (!hubUser.canFolha && !hubUser.canConci && !hubUser.canNcm) { %>
      <div class="hub-alert">Nenhum módulo liberado. Peça ao administrador do HUB.</div>
    <% } %>
  </div>
  <script src="/hub-assets/hub-menu.js"></script>
</body>
</html>

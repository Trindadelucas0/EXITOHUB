<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/hub-assets/hub.css" />
</head>
<body class="hub-body">
  <div class="hub-home">
    <section class="hub-home-top">
      <div class="hub-home-bar">
        <a href="/" class="hub-home-brand">
          <p class="hub-wordmark">Êxito</p>
          <p class="hub-kicker">HUB</p>
        </a>
        <div class="hub-home-actions">
          <% if (hubUser.isAdmin) { %>
            <a class="hub-btn hub-btn-ghost hub-btn-sm" href="/admin/usuarios">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                <circle cx="9.5" cy="7.5" r="3.5" stroke="currentColor" stroke-width="1.8"/>
                <path d="M19 8v6M16 11h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
              Gerenciar usuários
            </a>
          <% } %>
          <form method="post" action="/logout" class="hub-inline">
            <button type="submit" class="hub-btn hub-btn-ghost hub-btn-sm">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M9 21H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                <path d="M16 17l5-5-5-5M21 12H9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Sair
            </button>
          </form>
        </div>
      </div>

      <div class="hub-home-welcome">
        <h1>Bem-vindo, <%= hubUser.displayName || hubUser.username %></h1>
        <p>Selecione o sistema que deseja acessar</p>
      </div>
    </section>

    <div class="hub-modules">
      <% if (hubUser.canFolha) { %>
        <a class="hub-module-card hub-module-folha" href="/folha/modulos">
          <span class="hub-module-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M4 7h16M4 12h16M4 17h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </span>
          <strong>FOLHA &amp; FISCAL</strong>
          <span class="hub-module-desc">Controle de impostos da folha e resumo fiscal (Grupo Dauto).</span>
          <span class="hub-module-cta">Acessar &gt;</span>
        </a>
      <% } %>

      <% if (hubUser.canConci) { %>
        <a class="hub-module-card hub-module-conci" href="/conci/">
          <span class="hub-module-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <rect x="3" y="6" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.8"/>
              <path d="M3 10h18" stroke="currentColor" stroke-width="1.8"/>
            </svg>
          </span>
          <strong>CONCILIAÇÃO</strong>
          <span class="hub-module-desc">Upload de extrato, matching e exportação para o Domínio.</span>
          <span class="hub-module-cta">Acessar &gt;</span>
        </a>
      <% } %>

      <% if (hubUser.canNcm) { %>
        <a class="hub-module-card hub-module-ncm" href="/ncm/">
          <span class="hub-module-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M4 19V5h12l4 4v10H4z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              <path d="M16 5v4h4" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
            </svg>
          </span>
          <strong>AUDITOR NCM</strong>
          <span class="hub-module-desc">Conferência fiscal de produtos, regras NCM e divergências.</span>
          <span class="hub-module-cta">Acessar &gt;</span>
        </a>
      <% } %>
    </div>

    <% if (!hubUser.canFolha && !hubUser.canConci && !hubUser.canNcm) { %>
      <div class="hub-alert">Nenhum módulo liberado. Peça ao administrador do HUB.</div>
    <% } %>
  </div>
</body>
</html>

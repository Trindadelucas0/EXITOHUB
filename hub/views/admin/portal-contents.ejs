<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../partials/hub-head') %>
</head>
<body class="hub-body">
  <%- include('../partials/hub-chrome', { current: 'admin-portal', breadcrumb: 'Portal Corporativo' }) %>
  <main class="hub-shell-main">
    <section class="hub-card">
      <p class="hub-breadcrumb"><a href="/admin/portal">Portal Corporativo</a> / Conteúdos Êxito</p>
      <div class="hub-admin-head">
        <div>
          <h1>Conteúdos Êxito</h1>
          <p class="hub-muted">Slides do carrossel da Home. Vários podem ficar publicados ao mesmo tempo.</p>
        </div>
        <a class="hub-btn hub-btn-primary" href="/admin/portal/conteudos/novo<%= filtersQuery %>">+ Novo conteúdo</a>
      </div>
      <% if (flash) { %><div class="hub-alert hub-alert-ok" role="status"><%= flash %></div><% } %>
      <% if (error) { %><div class="hub-alert hub-alert-error" role="alert"><%= error %></div><% } %>

      <%- include('../partials/hub-admin-filters', {
        action: '/admin/portal/conteudos',
        filters: filters,
        hasFilter: hasFilter,
        placeholder: 'Buscar título',
        sitActiveLabel: 'Publicados',
        sitInactiveLabel: 'Rascunhos'
      }) %>

      <% if (editing) { %>
        <form method="post" action="<%= editing.id ? '/admin/portal/conteudos/' + editing.id : '/admin/portal/conteudos' %>" enctype="multipart/form-data" class="hub-admin-form" data-once>
          <%- include('../partials/hub-filter-fields', { filters: filters }) %>
          <h2><%= editing.id ? 'Editar conteúdo' : 'Novo conteúdo' %></h2>
          <label>Imagem <%= editing.id ? '' : '(obrigatória)' %>
            <input name="image" type="file" accept="image/jpeg,image/png,image/webp" <%= editing.id ? '' : 'required' %> />
          </label>
          <p class="hub-muted">Recomendado: 1280 × 720 px (16:9). JPG, PNG ou WebP, até 8 MB.<% if (editing.image_url) { %> Arquivo atual abaixo — envie outro só para substituir.<% } %></p>
          <% if (editing.image_url) { %>
            <p><img src="<%= editing.image_url %>" alt="" width="240" height="135" style="object-fit:cover;" /></p>
          <% } %>
          <label>Título <input name="title" required maxlength="160" value="<%= editing.title || '' %>" /></label>
          <label>Descrição <textarea name="description" rows="3" maxlength="1000"><%= editing.description || '' %></textarea></label>
          <label>Categoria
            <select name="category">
              <% categories.forEach(function (cat) { %>
                <option value="<%= cat %>" <%= editing.category === cat ? 'selected' : '' %>><%= cat %></option>
              <% }) %>
            </select>
          </label>
          <fieldset>
            <legend>Destino ao clicar</legend>
            <% targetTypes.forEach(function (t) { %>
              <label class="hub-check">
                <input type="radio" name="target_type" value="<%= t %>" <%= (editing.target_type || 'none') === t ? 'checked' : '' %> />
                <%= t === 'none' ? 'Não possui link' : (t === 'internal' ? 'Página interna' : 'Link externo') %>
              </label>
            <% }) %>
          </fieldset>
          <label>URL externa <input name="target_url" type="url" maxlength="2000" value="<%= editing.target_url || '' %>" placeholder="https://" /></label>
          <label>Página interna <input name="target_route" maxlength="300" value="<%= editing.target_route || '' %>" placeholder="/portal/..." /></label>
          <label>Ordem <input name="sort_order" type="number" value="<%= editing.sort_order != null ? editing.sort_order : 0 %>" /></label>
          <label class="hub-check"><input type="checkbox" name="is_published" value="1" <%= editing.id ? (editing.is_published ? 'checked' : '') : 'checked' %> /> Publicado (aparece na Home)</label>
          <div class="hub-form-actions">
            <a class="hub-btn hub-btn-ghost" href="/admin/portal/conteudos<%= filtersQuery %>">Cancelar</a>
            <button type="submit" class="hub-btn hub-btn-primary" data-busy="Salvando...">Salvar</button>
          </div>
        </form>
      <% } %>

      <% if (!(contents || []).length && !hasFilter) { %>
        <div class="hub-admin-empty">
          <p>Você ainda não possui conteúdos no carrossel.</p>
          <a class="hub-btn hub-btn-primary" href="/admin/portal/conteudos/novo">+ Novo conteúdo</a>
        </div>
      <% } else if (!(contents || []).length) { %>
        <div class="hub-admin-empty">
          <p>Nenhum conteúdo neste filtro.</p>
          <a class="hub-btn hub-btn-ghost" href="/admin/portal/conteudos">Limpar</a>
        </div>
      <% } else { %>
        <div class="hub-admin-table-wrap hub-admin-table-wrap--stack">
          <table class="hub-admin-table">
            <thead>
              <tr>
                <th>Título</th>
                <th>Categoria</th>
                <th>Situação</th>
                <th>Ordem</th>
                <th>Ações</th>
              </tr>
            </thead>
            <tbody>
              <% contents.forEach(function (item) { %>
                <tr>
                  <td data-label="Título"><strong><%= item.title %></strong></td>
                  <td data-label="Categoria"><%= item.category %></td>
                  <td data-label="Situação"><span class="hub-pill<%= item.is_published ? ' hub-pill-ok' : '' %>"><%= item.is_published ? 'Publicado' : 'Rascunho' %></span></td>
                  <td data-label="Ordem"><%= item.sort_order %></td>
                  <td data-label="Ações">
                    <div class="hub-admin-list__actions">
                      <a class="hub-btn hub-btn-ghost hub-btn-sm" href="/admin/portal/conteudos/<%= item.id %>/editar<%= filtersQuery %>">Editar</a>
                      <form method="post" action="/admin/portal/conteudos/<%= item.id %>/status">
                        <%- include('../partials/hub-filter-fields', { filters: filters }) %>
                        <input type="hidden" name="active" value="<%= item.is_published ? '0' : '1' %>" />
                        <button type="submit" class="hub-btn hub-btn-ghost hub-btn-sm"><%= item.is_published ? 'Desativar' : 'Publicar' %></button>
                      </form>
                      <button type="button" class="hub-btn hub-btn-ghost hub-btn-sm" data-open-dialog="dlg-content-<%= item.id %>">Excluir</button>
                    </div>
                    <%- include('../partials/hub-confirm-dialog', {
                      dialogId: 'dlg-content-' + item.id,
                      recordName: item.title,
                      heading: 'Excluir conteúdo?',
                      message: 'Esse slide sai do carrossel da Home.',
                      action: '/admin/portal/conteudos/' + item.id + '/excluir',
                      filters: filters,
                      autoOpen: String(confirmar) === String(item.id),
                      confirmLabel: 'Excluir',
                      busyLabel: 'Excluindo...'
                    }) %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>
  <%- include('../partials/hub-chrome-end') %>
</body>
</html>

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/hub-assets/hub.css" />
</head>
<body class="hub-body">
  <%- include('../partials/hub-chrome', { current: 'admin-portal' }) %>
  <main class="hub-main hub-portal-page">
    <section class="hub-card">
      <p class="hub-breadcrumb"><a href="/admin/portal">Portal Corporativo</a> / Links Úteis</p>
      <div class="hub-admin-head">
        <h1>Links Úteis</h1>
        <a class="hub-btn hub-btn-primary" href="/admin/portal/links/novo">+ Adicionar link</a>
      </div>
      <% if (flash) { %><div class="hub-alert hub-alert-ok"><%= flash %></div><% } %>
      <% if (error) { %><div class="hub-alert hub-alert-error"><%= error %></div><% } %>

      <% if (editing) { %>
        <form method="post" action="<%= editing.id ? '/admin/portal/links/' + editing.id : '/admin/portal/links' %>" class="hub-admin-form">
          <h2><%= editing.id ? 'Editar link' : 'Adicionar link' %></h2>
          <label>Nome do link
            <input name="name" required maxlength="120" value="<%= editing.name || '' %>" />
          </label>
          <label>Descrição
            <input name="description" maxlength="500" value="<%= editing.description || '' %>" />
          </label>
          <label>URL (https)
            <input name="url" type="url" required maxlength="2000" value="<%= editing.url || '' %>" placeholder="https://" />
          </label>
          <label>Categoria
            <select name="category">
              <% categories.forEach(function (cat) { %>
                <option value="<%= cat %>" <%= editing.category === cat ? 'selected' : '' %>><%= cat %></option>
              <% }) %>
            </select>
          </label>
          <label>Ícone (texto opcional)
            <input name="icon" maxlength="40" value="<%= editing.icon || '' %>" />
          </label>
          <label>Ordem
            <input name="sort_order" type="number" value="<%= editing.sort_order != null ? editing.sort_order : 0 %>" />
          </label>
          <label class="hub-check"><input type="checkbox" name="is_active" value="1" <%= editing.id ? (editing.is_active ? 'checked' : '') : 'checked' %> /> Ativo</label>
          <label class="hub-check"><input type="checkbox" name="show_on_home" value="1" <%= editing.id ? (editing.show_on_home ? 'checked' : '') : 'checked' %> /> Exibir na Home</label>
          <div class="hub-form-actions">
            <a class="hub-btn hub-btn-ghost" href="/admin/portal/links">Cancelar</a>
            <button type="submit" class="hub-btn hub-btn-primary">Salvar</button>
          </div>
        </form>
      <% } %>

      <% if (!(links || []).length) { %>
        <p class="hub-muted">Nenhum link cadastrado.</p>
      <% } else { %>
        <ul class="hub-admin-list">
          <% links.forEach(function (link) { %>
            <li class="hub-admin-list__item">
              <div>
                <strong><%= link.name %></strong>
                <span class="hub-muted"><%= link.description || '' %></span>
                <span class="hub-muted"><%= link.url %></span>
                <span class="hub-pill<%= link.is_active ? ' hub-pill-ok' : '' %>"><%= link.is_active ? 'Ativo' : 'Inativo' %></span>
              </div>
              <div class="hub-admin-list__actions">
                <a class="hub-btn hub-btn-ghost hub-btn-sm" href="/admin/portal/links/<%= link.id %>/editar">Editar</a>
                <form method="post" action="/admin/portal/links/<%= link.id %>/status">
                  <input type="hidden" name="active" value="<%= link.is_active ? '0' : '1' %>" />
                  <button type="submit" class="hub-btn hub-btn-ghost hub-btn-sm"><%= link.is_active ? 'Desativar' : 'Ativar' %></button>
                </form>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>
  </main>
</body>
</html>

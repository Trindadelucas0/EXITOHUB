<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../partials/hub-head') %>
</head>
<body class="hub-body">
  <%- include('../partials/hub-chrome', { current: 'admin-portal', breadcrumb: 'Portal Corporativo' }) %>
  <main class="hub-shell-main">
    <section class="hub-card">
      <p class="hub-breadcrumb"><a href="/admin/portal">Portal Corporativo</a> / <%= meta.label %></p>
      <div class="hub-admin-head">
        <h1><%= meta.label %></h1>
        <a class="hub-btn hub-btn-primary" href="/admin/portal/itens/<%= kind %>/novo">+ Adicionar</a>
      </div>
      <% if (flash) { %><div class="hub-alert hub-alert-ok"><%= flash %></div><% } %>
      <% if (error) { %><div class="hub-alert hub-alert-error"><%= error %></div><% } %>

      <% if (editing) { %>
        <form method="post" action="<%= editing.id ? '/admin/portal/itens/' + kind + '/' + editing.id : '/admin/portal/itens/' + kind %>" enctype="multipart/form-data" class="hub-admin-form">
          <h2><%= editing.id ? 'Editar' : 'Novo item' %></h2>
          <label>Título <input name="title" required maxlength="200" value="<%= editing.title || '' %>" /></label>
          <label>Descrição <input name="description" maxlength="1000" value="<%= editing.description || '' %>" /></label>
          <label>Categoria <input name="category" maxlength="80" value="<%= editing.category || '' %>" placeholder="Ex.: Fiscal, Comercial" /></label>
          <label>Departamento
            <select name="department">
              <option value="">—</option>
              <% (departments || []).forEach(function (d) { %>
                <option value="<%= d %>" <%= editing.department === d ? 'selected' : '' %>><%= d %></option>
              <% }) %>
            </select>
          </label>
          <label>Versão <input name="version" maxlength="40" value="<%= editing.version || '' %>" placeholder="Ex.: 1.2" /></label>
          <label>Texto / corpo <textarea name="body" rows="4" maxlength="20000"><%= editing.body || '' %></textarea></label>
          <% if (kind === 'video') { %>
            <label>Link do YouTube
              <input name="external_url" type="url" required maxlength="2000" value="<%= editing.external_url || '' %>" placeholder="https://www.youtube.com/watch?v=..." />
            </label>
            <p class="hub-muted">Cole o link do vídeo (youtube.com ou youtu.be). O funcionário verá o player embutido na página.</p>
          <% } else { %>
            <label>URL externa (https) <input name="external_url" type="url" maxlength="2000" value="<%= editing.external_url || '' %>" /></label>
            <label>Arquivo
              <input name="file" type="file" accept="<%= kind === 'logo' || kind === 'diagram' ? 'image/jpeg,image/png,image/webp' : 'application/pdf,image/jpeg,image/png,image/webp' %>" />
            </label>
            <% if (editing.file_url) { %><p class="hub-muted">Arquivo atual: <a href="<%= editing.file_url %>" target="_blank" rel="noopener noreferrer">abrir</a></p><% } %>
          <% } %>
          <label>Capa / thumbnail (imagem<%= kind === 'video' ? ' — opcional; sem capa usa a do YouTube' : '' %>)
            <input name="thumbnail" type="file" accept="image/jpeg,image/png,image/webp" />
          </label>
          <% if (editing.thumbnail_url) { %>
            <p><img src="<%= editing.thumbnail_url %>" alt="" width="120" height="80" style="object-fit:cover;border-radius:8px;" /></p>
          <% } %>
          <label>Ordem <input name="sort_order" type="number" value="<%= editing.sort_order != null ? editing.sort_order : 0 %>" /></label>
          <label class="hub-check"><input type="checkbox" name="is_active" value="1" <%= editing.id ? (editing.is_active ? 'checked' : '') : 'checked' %> /> Ativo</label>
          <label class="hub-check"><input type="checkbox" name="is_onboarding_required" value="1" <%= editing.is_onboarding_required ? 'checked' : '' %> /> Obrigatório no onboarding</label>
          <div class="hub-form-actions">
            <a class="hub-btn hub-btn-ghost" href="/admin/portal/itens/<%= kind %>">Cancelar</a>
            <button type="submit" class="hub-btn hub-btn-primary">Salvar</button>
          </div>
        </form>
      <% } %>

      <% if (!(items || []).length) { %>
        <p class="hub-muted">Nenhum item cadastrado.</p>
      <% } else { %>
        <ul class="hub-admin-list">
          <% items.forEach(function (item) { %>
            <li class="hub-admin-list__item">
              <div class="hub-admin-content-row">
                <% if (item.cover_url) { %>
                  <img src="<%= item.cover_url %>" alt="" width="72" height="52" />
                <% } %>
                <div>
                <strong><%= item.title %></strong>
                <% if (item.description) { %><span class="hub-muted"><%= item.description %></span><% } %>
                <span class="hub-muted">
                  <% if (item.department) { %><%= item.department %><% } %>
                  <% if (item.version) { %> · v<%= item.version %><% } %>
                  <% if (item.category) { %> · <%= item.category %><% } %>
                </span>
                <span class="hub-pill<%= item.is_active ? ' hub-pill-ok' : '' %>"><%= item.is_active ? 'Ativo' : 'Inativo' %></span>
                <% if (item.is_onboarding_required) { %><span class="hub-pill">Onboarding</span><% } %>
                </div>
              </div>
              <div class="hub-admin-list__actions">
                <a class="hub-btn hub-btn-ghost hub-btn-sm" href="/admin/portal/itens/<%= kind %>/<%= item.id %>/editar">Editar</a>
                <form method="post" action="/admin/portal/itens/<%= kind %>/<%= item.id %>/status">
                  <input type="hidden" name="active" value="<%= item.is_active ? '0' : '1' %>" />
                  <button type="submit" class="hub-btn hub-btn-ghost hub-btn-sm"><%= item.is_active ? 'Desativar' : 'Ativar' %></button>
                </form>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>
  </main>
  <%- include('../partials/hub-chrome-end') %>
</body>
</html>

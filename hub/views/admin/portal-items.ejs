<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../partials/hub-head') %>
</head>
<body class="hub-body">
  <%- include('../partials/hub-chrome', { current: 'admin-portal', breadcrumb: 'Portal Corporativo' }) %>
  <main class="hub-shell-main">
    <section class="hub-card">
      <p class="hub-breadcrumb"><a href="/admin/portal">Portal Corporativo</a> / <%= meta.label %></p>
      <div class="hub-admin-head">
        <div>
          <h1><%= meta.label %></h1>
          <p class="hub-muted"><%= meta.description %></p>
          <p class="hub-muted">Aparece em <a href="<%= meta.route %>"><%= meta.route %></a>. Não entra na Home como item.</p>
        </div>
        <a class="hub-btn hub-btn-primary" href="/admin/portal/itens/<%= kind %>/novo<%= filtersQuery %>">+ Adicionar</a>
      </div>
      <% if (flash) { %><div class="hub-alert hub-alert-ok" role="status"><%= flash %></div><% } %>
      <% if (error) { %><div class="hub-alert hub-alert-error" role="alert"><%= error %></div><% } %>

      <%- include('../partials/hub-admin-filters', {
        action: '/admin/portal/itens/' + kind,
        filters: filters,
        hasFilter: hasFilter,
        placeholder: 'Buscar título, categoria ou setor',
        sitActiveLabel: 'Ativos',
        sitInactiveLabel: 'Inativos'
      }) %>

      <% if (editing) { %>
        <form method="post" action="<%= editing.id ? '/admin/portal/itens/' + kind + '/' + editing.id : '/admin/portal/itens/' + kind %>" enctype="multipart/form-data" class="hub-admin-form" data-once>
          <%- include('../partials/hub-filter-fields', { filters: filters }) %>
          <h2><%= editing.id ? 'Editar' : 'Novo item' %></h2>
          <label>Título <input name="title" required maxlength="200" value="<%= editing.title || '' %>" /></label>
          <label>Descrição <input name="description" maxlength="1000" value="<%= editing.description || '' %>" /></label>
          <label>Categoria <input name="category" maxlength="80" value="<%= editing.category || '' %>" /></label>
          <label>Departamento
            <select name="department">
              <option value="">—</option>
              <% (departments || []).forEach(function (d) { %>
                <option value="<%= d %>" <%= editing.department === d ? 'selected' : '' %>><%= d %></option>
              <% }) %>
            </select>
          </label>
          <label>Versão <input name="version" maxlength="40" value="<%= editing.version || '' %>" /></label>
          <label>Texto / corpo <textarea name="body" rows="4" maxlength="20000"><%= editing.body || '' %></textarea></label>
          <% if (kind === 'video') { %>
            <label>Link do YouTube
              <input name="external_url" type="url" required maxlength="2000" value="<%= editing.external_url || '' %>" placeholder="https://www.youtube.com/watch?v=..." />
            </label>
            <p class="hub-muted">Cole o link do vídeo (youtube.com ou youtu.be). O player da trilha continua abrindo o próximo item não concluído.</p>
          <% } else { %>
            <label>URL externa (https)
              <input name="external_url" type="url" maxlength="2000" value="<%= editing.external_url || '' %>" placeholder="https://" />
            </label>
            <label>Arquivo
              <input name="file" type="file" accept="<%= kind === 'diagram' ? 'image/jpeg,image/png,image/webp' : 'application/pdf,image/jpeg,image/png,image/webp' %>" />
            </label>
            <p class="hub-muted">PDF até 15 MB. Imagem até 8 MB.<% if (editing.file_url) { %> Arquivo atual: <a href="<%= editing.file_url %>">abrir</a>. Envie outro só para substituir.<% } %></p>
          <% } %>
          <label>Capa / thumbnail
            <input name="thumbnail" type="file" accept="image/jpeg,image/png,image/webp" />
          </label>
          <% if (editing.thumbnail_url) { %>
            <p class="hub-muted">Capa atual</p>
            <p><img src="<%= editing.thumbnail_url %>" alt="" width="120" height="80" style="object-fit:cover;" /></p>
          <% } %>
          <label>Ordem <input name="sort_order" type="number" value="<%= editing.sort_order != null ? editing.sort_order : 0 %>" /></label>
          <label class="hub-check"><input type="checkbox" name="is_active" value="1" <%= editing.id ? (editing.is_active ? 'checked' : '') : 'checked' %> /> Ativo</label>
          <label class="hub-check"><input type="checkbox" name="is_onboarding_required" value="1" <%= editing.is_onboarding_required ? 'checked' : '' %> /> Obrigatório no onboarding</label>
          <div class="hub-form-actions">
            <a class="hub-btn hub-btn-ghost" href="/admin/portal/itens/<%= kind %><%= filtersQuery %>">Cancelar</a>
            <button type="submit" class="hub-btn hub-btn-primary" data-busy="Salvando...">Salvar</button>
          </div>
        </form>
      <% } %>

      <% if (!(items || []).length && !hasFilter) { %>
        <div class="hub-admin-empty">
          <p>Você ainda não possui itens em <%= meta.label %>.</p>
          <a class="hub-btn hub-btn-primary" href="/admin/portal/itens/<%= kind %>/novo">+ Adicionar</a>
        </div>
      <% } else if (!(items || []).length) { %>
        <div class="hub-admin-empty">
          <p>Nenhum item neste filtro.</p>
          <a class="hub-btn hub-btn-ghost" href="/admin/portal/itens/<%= kind %>">Limpar</a>
        </div>
      <% } else { %>
        <% var featuredTitle = '';
           items.forEach(function (it) { if (it.is_featured) featuredTitle = it.title; }); %>
        <div class="hub-admin-table-wrap hub-admin-table-wrap--stack">
          <table class="hub-admin-table">
            <thead>
              <tr>
                <th>Título</th>
                <th>Categoria</th>
                <th>Situação</th>
                <th>Ordem</th>
                <th>Ações</th>
              </tr>
            </thead>
            <tbody>
              <% items.forEach(function (item) {
                var progressCount = (progressMap && progressMap[String(item.id)]) || 0;
                var deleteMessage = progressCount
                  ? (progressCount + (progressCount === 1 ? ' colaborador já marcou' : ' colaboradores já marcaram') + ' este item. O progresso deste item será apagado.')
                  : 'Esse item sai da biblioteca. O arquivo enviado permanece no servidor.';
              %>
                <tr>
                  <td data-label="Título">
                    <strong><%= item.title %></strong>
                    <% if (item.is_featured) { %><span class="hub-pill hub-pill-ok">Destaque</span><% } %>
                    <% if (item.version) { %><span class="hub-muted">v<%= item.version %></span><% } %>
                  </td>
                  <td data-label="Categoria"><%= item.category || item.department || '—' %></td>
                  <td data-label="Situação"><span class="hub-pill<%= item.is_active ? ' hub-pill-ok' : '' %>"><%= item.is_active ? 'Ativo' : 'Inativo' %></span></td>
                  <td data-label="Ordem"><%= item.sort_order %></td>
                  <td data-label="Ações">
                    <div class="hub-admin-list__actions">
                      <a class="hub-btn hub-btn-ghost hub-btn-sm" href="/admin/portal/itens/<%= kind %>/<%= item.id %>/editar<%= filtersQuery %>">Editar</a>
                      <form method="post" action="/admin/portal/itens/<%= kind %>/<%= item.id %>/status">
                        <%- include('../partials/hub-filter-fields', { filters: filters }) %>
                        <input type="hidden" name="active" value="<%= item.is_active ? '0' : '1' %>" />
                        <button type="submit" class="hub-btn hub-btn-ghost hub-btn-sm"><%= item.is_active ? 'Desativar' : 'Ativar' %></button>
                      </form>
                      <% if (kind === 'video' && !item.is_featured) { %>
                        <form method="post" action="/admin/portal/itens/video/<%= item.id %>/destaque">
                          <%- include('../partials/hub-filter-fields', { filters: filters }) %>
                          <button type="submit" class="hub-btn hub-btn-ghost hub-btn-sm">Definir como destaque</button>
                        </form>
                      <% } %>
                      <button type="button" class="hub-btn hub-btn-ghost hub-btn-sm" data-open-dialog="dlg-item-<%= item.id %>">Excluir</button>
                    </div>
                    <%- include('../partials/hub-confirm-dialog', {
                      dialogId: 'dlg-item-' + item.id,
                      recordName: item.title,
                      heading: 'Excluir item?',
                      message: deleteMessage,
                      action: '/admin/portal/itens/' + kind + '/' + item.id + '/excluir',
                      filters: filters,
                      autoOpen: String(confirmar) === String(item.id),
                      confirmLabel: 'Excluir',
                      busyLabel: 'Excluindo...'
                    }) %>
                    <% if (kind === 'video' && String(confirmarDestaque) === String(item.id)) { %>
                      <%- include('../partials/hub-confirm-dialog', {
                        dialogId: 'dlg-feature-' + item.id,
                        heading: 'Já existe um vídeo em destaque.',
                        message: (featuredTitle ? ('“' + featuredTitle + '” deixa de ser o destaque. ') : 'O destaque atual será substituído. ') + 'A ordem da trilha não muda.',
                        action: '/admin/portal/itens/video/' + item.id + '/destaque',
                        filters: filters,
                        autoOpen: true,
                        confirmLabel: 'Substituir destaque',
                        busyLabel: 'Salvando...'
                      }) %>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>
  <%- include('../partials/hub-chrome-end') %>
</body>
</html>

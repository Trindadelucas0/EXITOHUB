<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../partials/hub-head') %>
</head>
<body class="hub-body">
  <%- include('../partials/hub-chrome', { current: 'admin-portal', breadcrumb: 'Portal Corporativo' }) %>
  <main class="hub-shell-main">
    <section class="hub-card">
      <p class="hub-breadcrumb"><a href="/admin/portal">Portal Corporativo</a> / Comunicados</p>
      <div class="hub-admin-head">
        <div>
          <h1>Comunicados</h1>
          <p class="hub-muted">Avisos ativos aparecem na Home e em Comunicados.</p>
        </div>
        <a class="hub-btn hub-btn-primary" href="/admin/portal/comunicados/novo<%= filtersQuery %>">+ Novo comunicado</a>
      </div>
      <% if (flash) { %><div class="hub-alert hub-alert-ok" role="status"><%= flash %></div><% } %>
      <% if (error) { %><div class="hub-alert hub-alert-error" role="alert"><%= error %></div><% } %>

      <%- include('../partials/hub-admin-filters', {
        action: '/admin/portal/comunicados',
        filters: filters,
        hasFilter: hasFilter,
        placeholder: 'Buscar título ou texto',
        sitActiveLabel: 'Ativos',
        sitInactiveLabel: 'Inativos'
      }) %>

      <% if (editing) { %>
        <form method="post" action="<%= editing.id ? '/admin/portal/comunicados/' + editing.id : '/admin/portal/comunicados' %>" class="hub-admin-form" data-once>
          <%- include('../partials/hub-filter-fields', { filters: filters }) %>
          <h2><%= editing.id ? 'Editar comunicado' : 'Novo comunicado' %></h2>
          <label>Título <input name="title" required maxlength="200" value="<%= editing.title || '' %>" /></label>
          <label>Texto <textarea name="body" rows="4" maxlength="5000"><%= editing.body || '' %></textarea></label>
          <label>Data
            <input name="published_at" type="datetime-local" required value="<%= formatDatetimeLocal(editing.published_at) %>" />
          </label>
          <label>Tipo
            <select name="kind">
              <% announcementKinds.forEach(function (k) { %>
                <option value="<%= k.id %>" <%= (editing.kind || 'operacional') === k.id ? 'selected' : '' %>><%= k.label %></option>
              <% }) %>
            </select>
          </label>
          <label class="hub-check"><input type="checkbox" name="is_active" value="1" <%= editing.id ? (editing.is_active ? 'checked' : '') : 'checked' %> /> Ativo</label>
          <div class="hub-form-actions">
            <a class="hub-btn hub-btn-ghost" href="/admin/portal/comunicados<%= filtersQuery %>">Cancelar</a>
            <button type="submit" class="hub-btn hub-btn-primary" data-busy="Salvando...">Salvar</button>
          </div>
        </form>
      <% } %>

      <% if (!(announcements || []).length && !hasFilter) { %>
        <div class="hub-admin-empty">
          <p>Você ainda não possui comunicados.</p>
          <a class="hub-btn hub-btn-primary" href="/admin/portal/comunicados/novo">+ Novo comunicado</a>
        </div>
      <% } else if (!(announcements || []).length) { %>
        <div class="hub-admin-empty">
          <p>Nenhum comunicado neste filtro.</p>
          <a class="hub-btn hub-btn-ghost" href="/admin/portal/comunicados">Limpar</a>
        </div>
      <% } else { %>
        <div class="hub-admin-table-wrap hub-admin-table-wrap--stack">
          <table class="hub-admin-table">
            <thead>
              <tr>
                <th>Título</th>
                <th>Tipo</th>
                <th>Data</th>
                <th>Situação</th>
                <th>Ações</th>
              </tr>
            </thead>
            <tbody>
              <% announcements.forEach(function (item) { %>
                <% const kindMeta = announcementKinds.find(function (k) { return k.id === item.kind; }) || announcementKinds[0]; %>
                <tr>
                  <td data-label="Título"><strong><%= item.title %></strong></td>
                  <td data-label="Tipo"><%= kindMeta.label %></td>
                  <td data-label="Data"><%= formatDatetimeLocal(item.published_at).replace('T', ' ') %></td>
                  <td data-label="Situação"><span class="hub-pill<%= item.is_active ? ' hub-pill-ok' : '' %>"><%= item.is_active ? 'Ativo' : 'Inativo' %></span></td>
                  <td data-label="Ações">
                    <div class="hub-admin-list__actions">
                      <a class="hub-btn hub-btn-ghost hub-btn-sm" href="/admin/portal/comunicados/<%= item.id %>/editar<%= filtersQuery %>">Editar</a>
                      <form method="post" action="/admin/portal/comunicados/<%= item.id %>/status">
                        <%- include('../partials/hub-filter-fields', { filters: filters }) %>
                        <input type="hidden" name="active" value="<%= item.is_active ? '0' : '1' %>" />
                        <button type="submit" class="hub-btn hub-btn-ghost hub-btn-sm"><%= item.is_active ? 'Desativar' : 'Ativar' %></button>
                      </form>
                      <button type="button" class="hub-btn hub-btn-ghost hub-btn-sm" data-open-dialog="dlg-ann-<%= item.id %>">Excluir</button>
                    </div>
                    <%- include('../partials/hub-confirm-dialog', {
                      dialogId: 'dlg-ann-' + item.id,
                      recordName: item.title,
                      heading: 'Excluir comunicado?',
                      message: 'Esse comunicado sai da Home e da lista pública.',
                      action: '/admin/portal/comunicados/' + item.id + '/excluir',
                      filters: filters,
                      autoOpen: String(confirmar) === String(item.id),
                      confirmLabel: 'Excluir',
                      busyLabel: 'Excluindo...'
                    }) %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>
  <%- include('../partials/hub-chrome-end') %>
</body>
</html>

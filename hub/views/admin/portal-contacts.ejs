<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../partials/hub-head') %>
</head>
<body class="hub-body">
  <%- include('../partials/hub-chrome', { current: 'admin-portal', breadcrumb: 'Portal Corporativo' }) %>
  <main class="hub-shell-main">
    <section class="hub-card">
      <p class="hub-breadcrumb"><a href="/admin/portal">Portal Corporativo</a> / Contatos Úteis</p>
      <div class="hub-admin-head">
        <div>
          <h1>Contatos Úteis</h1>
          <p class="hub-muted">Gerencie as pessoas exibidas na Home.</p>
        </div>
        <a class="hub-btn hub-btn-primary" href="/admin/portal/contatos/novo<%= filtersQuery %>">+ Adicionar contato</a>
      </div>
      <% if (flash) { %><div class="hub-alert hub-alert-ok" role="status"><%= flash %></div><% } %>
      <% if (error) { %><div class="hub-alert hub-alert-error" role="alert"><%= error %></div><% } %>

      <%- include('../partials/hub-admin-filters', {
        action: '/admin/portal/contatos',
        filters: filters,
        hasFilter: hasFilter,
        departments: departments,
        showDepartment: true,
        placeholder: 'Buscar nome, setor ou e-mail',
        sitActiveLabel: 'Ativos',
        sitInactiveLabel: 'Inativos'
      }) %>

      <% if (editing) { %>
        <form method="post" action="<%= editing.id ? '/admin/portal/contatos/' + editing.id : '/admin/portal/contatos' %>" enctype="multipart/form-data" class="hub-admin-form" data-once>
          <%- include('../partials/hub-filter-fields', { filters: filters }) %>
          <h2><%= editing.id ? 'Editar contato' : 'Adicionar contato' %></h2>
          <label>Nome <input name="name" required maxlength="120" value="<%= editing.name || '' %>" /></label>
          <label>Cargo <input name="role" maxlength="120" value="<%= editing.role || '' %>" /></label>
          <label>Departamento
            <select name="department">
              <% departments.forEach(function (d) { %>
                <option value="<%= d %>" <%= editing.department === d ? 'selected' : '' %>><%= d %></option>
              <% }) %>
            </select>
          </label>
          <label>E-mail <input name="email" type="email" maxlength="200" value="<%= editing.email || '' %>" /></label>
          <label>Telefone <input name="phone" maxlength="40" value="<%= editing.phone || '' %>" /></label>
          <label>WhatsApp (somente números) <input name="whatsapp" maxlength="15" value="<%= editing.whatsapp || '' %>" /></label>
          <label>Descrição <textarea name="description" rows="3" maxlength="1000"><%= editing.description || '' %></textarea></label>
          <label>Foto <% if (editing.photo_url) { %><span class="hub-muted">(arquivo atual — envie outro para substituir)</span><% } %>
            <input name="photo" type="file" accept="image/jpeg,image/png,image/webp" />
          </label>
          <p class="hub-muted">JPG, PNG ou WebP, até 8 MB.</p>
          <label>Ordem <input name="sort_order" type="number" value="<%= editing.sort_order != null ? editing.sort_order : 0 %>" /></label>
          <label class="hub-check"><input type="checkbox" name="is_active" value="1" <%= editing.id ? (editing.is_active ? 'checked' : '') : 'checked' %> /> Ativo (aparece na Home)</label>
          <div class="hub-form-actions">
            <a class="hub-btn hub-btn-ghost" href="/admin/portal/contatos<%= filtersQuery %>">Cancelar</a>
            <button type="submit" class="hub-btn hub-btn-primary" data-busy="Salvando...">Salvar</button>
          </div>
        </form>
      <% } %>

      <% if (!(contacts || []).length && !hasFilter) { %>
        <div class="hub-admin-empty">
          <p>Você ainda não possui contatos cadastrados.</p>
          <a class="hub-btn hub-btn-primary" href="/admin/portal/contatos/novo">+ Adicionar contato</a>
        </div>
      <% } else if (!(contacts || []).length) { %>
        <div class="hub-admin-empty">
          <p>Nenhum contato neste filtro.</p>
          <a class="hub-btn hub-btn-ghost" href="/admin/portal/contatos">Limpar</a>
        </div>
      <% } else { %>
        <div class="hub-admin-table-wrap hub-admin-table-wrap--stack">
          <table class="hub-admin-table">
            <thead>
              <tr>
                <th>Nome</th>
                <th>Setor</th>
                <th>E-mail</th>
                <th>Situação</th>
                <th>Ações</th>
              </tr>
            </thead>
            <tbody>
              <% contacts.forEach(function (c) { %>
                <tr>
                  <td data-label="Nome"><strong><%= c.name %></strong><% if (c.role) { %><span class="hub-muted"><%= c.role %></span><% } %></td>
                  <td data-label="Setor"><%= c.department %></td>
                  <td data-label="E-mail"><%= c.email || '—' %></td>
                  <td data-label="Situação"><span class="hub-pill<%= c.is_active ? ' hub-pill-ok' : '' %>"><%= c.is_active ? 'Ativo' : 'Inativo' %></span></td>
                  <td data-label="Ações">
                    <div class="hub-admin-list__actions">
                      <a class="hub-btn hub-btn-ghost hub-btn-sm" href="/admin/portal/contatos/<%= c.id %>/editar<%= filtersQuery %>">Editar</a>
                      <form method="post" action="/admin/portal/contatos/<%= c.id %>/status">
                        <%- include('../partials/hub-filter-fields', { filters: filters }) %>
                        <input type="hidden" name="active" value="<%= c.is_active ? '0' : '1' %>" />
                        <button type="submit" class="hub-btn hub-btn-ghost hub-btn-sm"><%= c.is_active ? 'Desativar' : 'Ativar' %></button>
                      </form>
                      <button type="button" class="hub-btn hub-btn-ghost hub-btn-sm" data-open-dialog="dlg-contact-<%= c.id %>">Excluir</button>
                    </div>
                    <%- include('../partials/hub-confirm-dialog', {
                      dialogId: 'dlg-contact-' + c.id,
                      recordName: c.name,
                      heading: 'Excluir contato?',
                      message: 'Esse contato sai da Home e do portal.',
                      action: '/admin/portal/contatos/' + c.id + '/excluir',
                      filters: filters,
                      autoOpen: String(confirmar) === String(c.id),
                      confirmLabel: 'Excluir',
                      busyLabel: 'Excluindo...'
                    }) %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>
  <%- include('../partials/hub-chrome-end') %>
</body>
</html>

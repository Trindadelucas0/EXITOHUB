<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/hub-assets/hub.css" />
</head>
<body class="hub-body">
  <%- include('../partials/hub-chrome', { current: 'admin-portal' }) %>
  <main class="hub-main hub-portal-page">
    <section class="hub-card">
      <p class="hub-breadcrumb"><a href="/admin/portal">Portal Corporativo</a> / Contatos Úteis</p>
      <div class="hub-admin-head">
        <h1>Contatos Úteis</h1>
        <a class="hub-btn hub-btn-primary" href="/admin/portal/contatos/novo">+ Adicionar contato</a>
      </div>
      <% if (flash) { %><div class="hub-alert hub-alert-ok"><%= flash %></div><% } %>
      <% if (error) { %><div class="hub-alert hub-alert-error"><%= error %></div><% } %>

      <% if (editing) { %>
        <form method="post" action="<%= editing.id ? '/admin/portal/contatos/' + editing.id : '/admin/portal/contatos' %>" enctype="multipart/form-data" class="hub-admin-form">
          <h2><%= editing.id ? 'Editar contato' : 'Adicionar contato' %></h2>
          <label>Nome <input name="name" required maxlength="120" value="<%= editing.name || '' %>" /></label>
          <label>Cargo <input name="role" maxlength="120" value="<%= editing.role || '' %>" /></label>
          <label>Departamento
            <select name="department">
              <% departments.forEach(function (d) { %>
                <option value="<%= d %>" <%= editing.department === d ? 'selected' : '' %>><%= d %></option>
              <% }) %>
            </select>
          </label>
          <label>E-mail <input name="email" type="email" maxlength="200" value="<%= editing.email || '' %>" /></label>
          <label>Telefone <input name="phone" maxlength="40" value="<%= editing.phone || '' %>" /></label>
          <label>WhatsApp (somente números) <input name="whatsapp" maxlength="15" value="<%= editing.whatsapp || '' %>" /></label>
          <label>Descrição <textarea name="description" rows="3" maxlength="1000"><%= editing.description || '' %></textarea></label>
          <label>Foto <% if (editing.photo_url) { %><span class="hub-muted">(já existe — envie outra para substituir)</span><% } %>
            <input name="photo" type="file" accept="image/jpeg,image/png,image/webp" />
          </label>
          <label>Ordem <input name="sort_order" type="number" value="<%= editing.sort_order != null ? editing.sort_order : 0 %>" /></label>
          <label class="hub-check"><input type="checkbox" name="is_active" value="1" <%= editing.id ? (editing.is_active ? 'checked' : '') : 'checked' %> /> Ativo</label>
          <label class="hub-check"><input type="checkbox" name="show_on_home" value="1" <%= editing.id ? (editing.show_on_home ? 'checked' : '') : 'checked' %> /> Exibir na Home</label>
          <div class="hub-form-actions">
            <a class="hub-btn hub-btn-ghost" href="/admin/portal/contatos">Cancelar</a>
            <button type="submit" class="hub-btn hub-btn-primary">Salvar</button>
          </div>
        </form>
      <% } %>

      <% if (!(contacts || []).length) { %>
        <p class="hub-muted">Nenhum contato cadastrado.</p>
      <% } else { %>
        <ul class="hub-admin-list">
          <% contacts.forEach(function (c) { %>
            <li class="hub-admin-list__item">
              <div class="hub-portal-contact">
                <% if (c.photo_url) { %>
                  <img src="<%= c.photo_url %>" alt="" width="40" height="40" />
                <% } else { %>
                  <span class="hub-portal-contact__avatar"><%= String(c.name || '?').charAt(0).toUpperCase() %></span>
                <% } %>
                <div>
                  <strong><%= c.name %></strong>
                  <span class="hub-muted"><%= [c.role, c.department].filter(Boolean).join(' · ') %></span>
                  <% if (c.email) { %><span class="hub-muted"><%= c.email %></span><% } %>
                  <span class="hub-pill<%= c.is_active ? ' hub-pill-ok' : '' %>"><%= c.is_active ? 'Ativo' : 'Inativo' %></span>
                </div>
              </div>
              <div class="hub-admin-list__actions">
                <a class="hub-btn hub-btn-ghost hub-btn-sm" href="/admin/portal/contatos/<%= c.id %>/editar">Editar</a>
                <form method="post" action="/admin/portal/contatos/<%= c.id %>/status">
                  <input type="hidden" name="active" value="<%= c.is_active ? '0' : '1' %>" />
                  <button type="submit" class="hub-btn hub-btn-ghost hub-btn-sm"><%= c.is_active ? 'Desativar' : 'Ativar' %></button>
                </form>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>
  </main>
</body>
</html>

<%
  const u = hubUser || (typeof locals !== 'undefined' ? locals.hubUser : null);
  const cur = typeof current !== 'undefined' ? current : '';
  const crumb = typeof breadcrumb !== 'undefined' && breadcrumb
    ? breadcrumb
    : 'Portal Corporativo';
  const displayName = u ? (u.displayName || u.username || '') : '';
  const deptLabel = u && u.department ? u.department : '';
  const initials = (function () {
    const src = String(displayName || '?').trim();
    const parts = src.split(/\s+/).filter(Boolean);
    if (parts.length >= 2) return (parts[0].charAt(0) + parts[1].charAt(0)).toUpperCase();
    return src.slice(0, 2).toUpperCase();
  })();
%>
<div class="hub-shell-overlay" id="hub-menu-overlay" hidden></div>

<aside class="hub-sidebar" id="hub-app-menu" aria-label="Navegação do HUB">
  <%- include('hub-app-menu', { menuUser: u, current: cur, showHomeLink: true }) %>
</aside>

<div class="hub-shell">
  <header class="hub-topbar">
    <div class="hub-topbar__left">
      <button
        type="button"
        class="hub-menu-btn"
        id="hub-menu-btn"
        aria-expanded="false"
        aria-controls="hub-app-menu"
        aria-label="Abrir menu"
      >
        <span class="material-symbols-outlined" aria-hidden="true">menu</span>
      </button>
      <nav class="hub-topbar__crumb" aria-label="Localização">
        <span class="hub-topbar__crumb-root">Êxito HUB</span>
        <span class="hub-topbar__crumb-sep" aria-hidden="true">/</span>
        <span class="hub-topbar__crumb-page"><%= crumb %></span>
        <span class="hub-topbar__secure">
          <span class="material-symbols-outlined" aria-hidden="true">verified_user</span>
          Ambiente Seguro
        </span>
      </nav>
    </div>
    <div class="hub-topbar__right">
      <button type="button" class="hub-topbar__icon-btn" aria-label="Notificações" disabled title="Em breve">
        <span class="material-symbols-outlined" aria-hidden="true">notifications</span>
      </button>
      <% if (u) { %>
        <a class="hub-topbar__user hub-topbar__user-link" href="/perfil" title="Meu perfil">
          <span class="hub-topbar__avatar" aria-hidden="true">
            <% if (u.photoUrl) { %>
              <img src="<%= u.photoUrl %>" alt="" width="32" height="32" />
            <% } else { %>
              <%= initials %>
            <% } %>
          </span>
          <span class="hub-topbar__user-meta">
            <strong><%= displayName %></strong>
            <% if (deptLabel) { %><span><%= deptLabel %></span><% } %>
          </span>
        </a>
        <form method="post" action="/logout" class="hub-inline">
          <button type="submit" class="hub-topbar__logout">
            <span class="material-symbols-outlined" aria-hidden="true">logout</span>
            Sair
          </button>
        </form>
      <% } %>
    </div>
  </header>

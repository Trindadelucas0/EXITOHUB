<% if ((quickCards || []).length) { %>
<section class="hub-portal-quick" aria-label="Áreas da empresa">
  <span class="hub-portal-quick__label">Áreas da Empresa · Atalhos Rápidos</span>
  <div class="hub-portal-quick__row">
    <% quickCards.forEach(function (card) { %>
      <a class="hub-portal-quick__item" href="<%= card.route %>" title="<%= card.label %>">
        <span class="material-symbols-outlined hub-portal-quick__icon" aria-hidden="true"><%= card.materialIcon || 'link' %></span>
        <span class="hub-portal-quick__text"><%= card.short || card.label %></span>
      </a>
    <% }) %>
  </div>
</section>
<% } %>

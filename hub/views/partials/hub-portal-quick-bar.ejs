<% if ((quickCards || []).length) { %>
<section class="hub-portal-quick" aria-label="Áreas da empresa">
  <span class="font-label-sm hub-muted" style="display: block; font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 0.5rem;">
    Áreas da Empresa · Atalhos Rápidos
  </span>
  <div class="hub-portal-quick__row">
    <% quickCards.forEach(function (card) { %>
      <a class="hub-portal-quick__item" href="<%= card.route %>" title="<%= card.label %>">
        <span class="hub-portal-quick__icon" aria-hidden="true">
          <%- include('hub-menu-icon', { iconName: card.icon }) %>
        </span>
        <strong><%= card.short || card.label %></strong>
      </a>
    <% }) %>
  </div>
</section>
<% } %>

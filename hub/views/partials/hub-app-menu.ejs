<%
  const userForMenu = (typeof menuUser !== 'undefined' && menuUser)
    ? menuUser
    : (typeof hubUser !== 'undefined' ? hubUser : null);
  const menuCurrent = typeof current !== 'undefined' ? current : '';
  const showHome = typeof showHomeLink === 'undefined' ? true : Boolean(showHomeLink);
  const departments = (typeof hubMenu !== 'undefined' && Array.isArray(hubMenu))
    ? hubMenu
    : [];

  const moduleIds = ['geral', 'fiscal', 'contabil', 'folha'];
  const adminIds = ['administrativo'];
  const opsIds = ['projetos', 'agenda'];

  function pickDepts(ids) {
    return departments.filter(function (d) { return ids.indexOf(d.id) !== -1; });
  }

  const moduleDepts = pickDepts(moduleIds);
  const adminDepts = pickDepts(adminIds);
  const opsDepts = pickDepts(opsIds);
  const otherDepts = departments.filter(function (d) {
    return moduleIds.indexOf(d.id) === -1
      && adminIds.indexOf(d.id) === -1
      && opsIds.indexOf(d.id) === -1;
  });

  function isAdminHref(href) {
    const h = String(href || '');
    return h.indexOf('/admin/') === 0 || h === '/projetos';
  }

  const groups = [
    { label: 'Módulos & Sistemas', depts: moduleDepts, showDept: true },
    { label: 'Administrativo', depts: adminDepts, showDept: false },
    { label: 'Operações & Gestão', depts: opsDepts, showDept: false },
  ];
  if (otherDepts.length) {
    groups.push({ label: 'Outros', depts: otherDepts, showDept: true });
  }
%>
<div class="hub-sidebar__inner">
  <div class="hub-sidebar__brand">
    <a href="/" class="hub-sidebar__brand-link">
      <img src="/hub-assets/exito-hub-logo.svg" alt="" width="32" height="32" class="hub-sidebar__logo" />
      <span class="hub-sidebar__brand-text">
        <strong>Êxito HUB</strong>
        <span>Portal Corporativo</span>
      </span>
    </a>
  </div>

  <div class="hub-sidebar__scroll">
    <% if (showHome) { %>
      <div class="hub-sidebar__group">
        <nav class="hub-sidebar__nav" aria-label="Início">
          <a href="/" class="hub-sidebar__link<%= menuCurrent === 'home' ? ' is-active' : '' %>"<%= menuCurrent === 'home' ? ' aria-current="page"' : '' %>>
            <span class="hub-sidebar__link-main">
              <%- include('hub-menu-icon', { iconName: 'home' }) %>
              <span>Início</span>
            </span>
          </a>
        </nav>
      </div>
    <% } %>

    <% groups.forEach(function (group) { %>
      <% if (group.depts && group.depts.length) { %>
        <div class="hub-sidebar__group">
          <p class="hub-sidebar__group-label"><%= group.label %></p>
          <nav class="hub-sidebar__nav" aria-label="<%= group.label %>">
            <% group.depts.forEach(function (dept) { %>
              <% if (group.showDept && group.depts.length > 1 && dept.items.length > 1) { %>
                <p class="hub-sidebar__dept-label"><%= dept.label %></p>
              <% } %>
              <% dept.items.forEach(function (item) {
                const linkClasses = ['hub-sidebar__link'];
                if (item.currentKey === menuCurrent) linkClasses.push('is-active');
                if (item.status === 'soon') linkClasses.push('is-soon');
              %>
                <a
                  href="<%= item.href %>"
                  class="<%= linkClasses.join(' ') %>"
                  <% if (item.currentKey === menuCurrent) { %>aria-current="page"<% } %>
                  <% if (item.external) { %>target="_blank" rel="noopener noreferrer"<% } %>
                >
                  <span class="hub-sidebar__link-main">
                    <%- include('hub-menu-icon', { iconName: item.icon }) %>
                    <span><%= item.label %></span>
                  </span>
                  <% if (item.status === 'soon') { %>
                    <span class="hub-sidebar__badge">Em breve</span>
                  <% } else if (isAdminHref(item.href) && userForMenu && userForMenu.isAdmin) { %>
                    <span class="hub-sidebar__badge hub-sidebar__badge--muted">Admin</span>
                  <% } %>
                </a>
              <% }); %>
            <% }); %>
          </nav>
        </div>
      <% } %>
    <% }); %>
  </div>

  <div class="hub-sidebar__foot">
    <div>
      <span class="hub-sidebar__foot-label">Versão</span>
      <span class="hub-sidebar__foot-version">1.5.0</span>
    </div>
    <span class="hub-sidebar__status">Operacional</span>
  </div>
</div>

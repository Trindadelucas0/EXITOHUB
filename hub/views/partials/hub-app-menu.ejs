<%
  const userForMenu = (typeof menuUser !== 'undefined' && menuUser)
    ? menuUser
    : (typeof hubUser !== 'undefined' ? hubUser : null);
  const menuCurrent = typeof current !== 'undefined' ? current : '';
  const showHome = typeof showHomeLink === 'undefined' ? true : Boolean(showHomeLink);
  const departments = (typeof hubMenu !== 'undefined' && Array.isArray(hubMenu))
    ? hubMenu
    : [];

  const moduleIds = ['geral', 'fiscal', 'contabil', 'folha'];
  const adminIds = ['administrativo'];
  const opsIds = ['projetos', 'agenda'];

  function pickDepts(ids) {
    return departments.filter(function (d) { return ids.indexOf(d.id) !== -1; });
  }

  const moduleDepts = pickDepts(moduleIds);
  const adminDepts = pickDepts(adminIds);
  const opsDepts = pickDepts(opsIds);
  const otherDepts = departments.filter(function (d) {
    return moduleIds.indexOf(d.id) === -1
      && adminIds.indexOf(d.id) === -1
      && opsIds.indexOf(d.id) === -1;
  });

  function isAdminHref(href) {
    const h = String(href || '');
    return h.indexOf('/admin/') === 0 || h === '/projetos';
  }

  function splitItems(items) {
    const list = Array.isArray(items) ? items : [];
    const main = [];
    const config = [];
    list.forEach(function (item) {
      if (item.section === 'config') config.push(item);
      else main.push(item);
    });
    return { main: main, config: config };
  }

  function deptHasCurrent(dept) {
    return (dept.items || []).some(function (item) {
      return item.currentKey === menuCurrent;
    });
  }

  function deptsHaveCurrent(depts) {
    return (depts || []).some(deptHasCurrent);
  }

  function configHasCurrent(configItems) {
    return (configItems || []).some(function (item) {
      return item.currentKey === menuCurrent;
    });
  }

  const groups = [
    { id: 'modules', label: 'Módulos & Sistemas', depts: moduleDepts, mode: 'depts' },
    { id: 'admin', label: 'Administrativo', depts: adminDepts, mode: 'group' },
    { id: 'ops', label: 'Operações & Gestão', depts: opsDepts, mode: 'group-nested' },
  ];
  if (otherDepts.length) {
    groups.push({ id: 'other', label: 'Outros', depts: otherDepts, mode: 'depts' });
  }

  function chevronSvg() {
    return '<svg class="hub-sidebar__chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 18 6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  }

  function renderLink(item) {
    const linkClasses = ['hub-sidebar__link'];
    if (item.currentKey === menuCurrent) linkClasses.push('is-active');
    if (item.status === 'soon') linkClasses.push('is-soon');
%>
                <a
                  href="<%= item.href %>"
                  class="<%= linkClasses.join(' ') %>"
                  <% if (item.currentKey === menuCurrent) { %>aria-current="page"<% } %>
                  <% if (item.external) { %>target="_blank" rel="noopener noreferrer"<% } %>
                >
                  <span class="hub-sidebar__link-main">
                    <%- include('hub-menu-icon', { iconName: item.icon }) %>
                    <span><%= item.label %></span>
                  </span>
                  <% if (item.status === 'soon') { %>
                    <span class="hub-sidebar__badge">Em breve</span>
                  <% } else if (isAdminHref(item.href) && userForMenu && userForMenu.isAdmin) { %>
                    <span class="hub-sidebar__badge hub-sidebar__badge--muted">Admin</span>
                  <% } %>
                </a>
<%
  }

  function renderConfigBlock(configItems) {
    if (!configItems || !configItems.length) return;
    const openAttr = configHasCurrent(configItems) ? ' open' : '';
%>
              <details class="hub-sidebar__dept hub-sidebar__dept--nested" data-hub-menu-level="config"<%= openAttr %>>
                <summary class="hub-sidebar__dept-toggle">
                  <%- chevronSvg() %>
                  <span>Configuração</span>
                </summary>
                <div class="hub-sidebar__dept-body">
                  <% configItems.forEach(function (item) { renderLink(item); }); %>
                </div>
              </details>
<%
  }

  function renderDeptBody(dept) {
    const parts = splitItems(dept.items);
    parts.main.forEach(function (item) { renderLink(item); });
    renderConfigBlock(parts.config);
  }
%>
<div class="hub-sidebar__inner">
  <div class="hub-sidebar__brand">
    <a href="/" class="hub-sidebar__brand-link">
      <img src="/hub-assets/exito-hub-logo.svg" alt="" width="32" height="32" class="hub-sidebar__logo" />
      <span class="hub-sidebar__brand-text">
        <strong>Êxito HUB</strong>
        <span>Portal Corporativo</span>
      </span>
    </a>
  </div>

  <div class="hub-sidebar__scroll">
    <% if (showHome) { %>
      <div class="hub-sidebar__group">
        <nav class="hub-sidebar__nav" aria-label="Início">
          <a href="/" class="hub-sidebar__link<%= menuCurrent === 'home' ? ' is-active' : '' %>"<%= menuCurrent === 'home' ? ' aria-current="page"' : '' %>>
            <span class="hub-sidebar__link-main">
              <%- include('hub-menu-icon', { iconName: 'home' }) %>
              <span>Início</span>
            </span>
          </a>
        </nav>
      </div>
    <% } %>

    <% groups.forEach(function (group) { %>
      <% if (group.depts && group.depts.length) { %>
        <div class="hub-sidebar__group" data-hub-menu-group="<%= group.id %>">
          <% if (group.mode === 'depts') { %>
            <p class="hub-sidebar__group-label"><%= group.label %></p>
            <nav class="hub-sidebar__nav" aria-label="<%= group.label %>" data-hub-menu-accordion>
              <% group.depts.forEach(function (dept) {
                const openAttr = deptHasCurrent(dept) ? ' open' : '';
              %>
                <details class="hub-sidebar__dept" data-hub-menu-level="dept"<%= openAttr %>>
                  <summary class="hub-sidebar__dept-toggle">
                    <%- chevronSvg() %>
                    <span><%= dept.label %></span>
                  </summary>
                  <div class="hub-sidebar__dept-body">
                    <% renderDeptBody(dept); %>
                  </div>
                </details>
              <% }); %>
            </nav>
          <% } else if (group.mode === 'group') { %>
            <nav class="hub-sidebar__nav" aria-label="<%= group.label %>" data-hub-menu-accordion>
              <% const groupOpen = deptsHaveCurrent(group.depts) ? ' open' : ''; %>
              <details class="hub-sidebar__dept" data-hub-menu-level="dept"<%= groupOpen %>>
                <summary class="hub-sidebar__dept-toggle">
                  <%- chevronSvg() %>
                  <span><%= group.label %></span>
                </summary>
                <div class="hub-sidebar__dept-body">
                  <% group.depts.forEach(function (dept) { renderDeptBody(dept); }); %>
                </div>
              </details>
            </nav>
          <% } else if (group.mode === 'group-nested') { %>
            <nav class="hub-sidebar__nav" aria-label="<%= group.label %>" data-hub-menu-accordion>
              <% const opsOpen = deptsHaveCurrent(group.depts) ? ' open' : ''; %>
              <details class="hub-sidebar__dept" data-hub-menu-level="dept"<%= opsOpen %>>
                <summary class="hub-sidebar__dept-toggle">
                  <%- chevronSvg() %>
                  <span><%= group.label %></span>
                </summary>
                <div class="hub-sidebar__dept-body" data-hub-menu-accordion>
                  <% group.depts.forEach(function (dept) {
                    const nestedOpen = deptHasCurrent(dept) ? ' open' : '';
                  %>
                    <details class="hub-sidebar__dept hub-sidebar__dept--nested" data-hub-menu-level="nested"<%= nestedOpen %>>
                      <summary class="hub-sidebar__dept-toggle">
                        <%- chevronSvg() %>
                        <span><%= dept.label %></span>
                      </summary>
                      <div class="hub-sidebar__dept-body">
                        <% renderDeptBody(dept); %>
                      </div>
                    </details>
                  <% }); %>
                </div>
              </details>
            </nav>
          <% } %>
        </div>
      <% } %>
    <% }); %>
  </div>

  <div class="hub-sidebar__foot">
    <div>
      <span class="hub-sidebar__foot-label">Versão</span>
      <span class="hub-sidebar__foot-version">1.5.25</span>
    </div>
    <span class="hub-sidebar__status">Operacional</span>
  </div>
</div>

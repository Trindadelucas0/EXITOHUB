<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/hub-head') %>
</head>
<body class="hub-body">
  <%- include('partials/hub-chrome', {
    current: typeof current !== 'undefined' ? current : '',
    breadcrumb: moduleTitle
  }) %>
  <main class="hub-shell-main">
    <section class="hub-empty-panel" style="text-align: left;">
      <h1 style="margin: 0 0 0.5rem; font-size: 1.5rem;"><%= moduleTitle %></h1>
      <% if (notFound) { %>
        <p class="hub-muted"><%= moduleDescription %></p>
      <% } else { %>
        <p class="hub-muted">Este módulo entra em uma próxima etapa. O menu já aponta para cá para centralizar o acesso.</p>
        <% if (moduleDescription) { %>
          <p><%= moduleDescription %></p>
        <% } %>
      <% } %>
      <p style="margin-top: 1.25rem;"><a class="hub-btn hub-btn-primary" href="/">Voltar ao início</a></p>
    </section>
  </main>
  <%- include('partials/hub-chrome-end') %>
</body>
</html>

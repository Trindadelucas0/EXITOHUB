<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/hub-head') %>
</head>
<body class="hub-body">
  <%- include('partials/hub-chrome', { current: 'projetos', breadcrumb: 'Projetos & Chamados' }) %>

  <main class="hub-shell-main">
    <header class="hub-page-head">
      <p class="hub-page-head__eyebrow">Projetos &amp; Chamados</p>
      <h1>Projetos e Chamados (Avadesk)</h1>
    </header>

    <section class="hub-project-hero">
      <div>
        <p class="hub-muted" style="font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; margin: 0 0 0.35rem;">
          Plataforma homologada
        </p>
        <h2 style="margin: 0; font-size: 1.25rem; font-weight: 700;">Avadesk — Central de Suporte e Gestão de Projetos</h2>
        <p class="hub-muted" style="margin: 0.75rem 0 0; max-width: 40rem;">
          Chamados da Equipe de TI (bugs, ajustes e módulos) entram no portal Avadesk. Use o botão abaixo para abrir a central de suporte.
        </p>
      </div>
      <div class="hub-project-hero__actions">
        <a
          class="hub-btn hub-btn-primary"
          href="<%= avadeskUrl %>"
          target="_blank"
          rel="noopener noreferrer"
        >
          Abrir Portal Avadesk
          <span class="material-symbols-outlined" aria-hidden="true" style="font-size: 1rem;">open_in_new</span>
        </a>
      </div>
    </section>

    <section class="hub-project-channels" aria-labelledby="hub-project-channels-title">
      <header class="hub-project-channels__head">
        <p class="hub-muted" style="font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; margin: 0 0 0.25rem;">
          Diretrizes rápidas
        </p>
        <h2 id="hub-project-channels-title" style="margin: 0; font-size: 1.125rem; font-weight: 700;">Canais</h2>
      </header>

      <div class="hub-project-channels__grid">
        <article class="hub-project-channel">
          <div class="hub-project-channel__icon" aria-hidden="true">
            <span class="material-symbols-outlined">router</span>
          </div>
          <h3 class="hub-project-channel__title">Suporte de TI e Infraestrutura</h3>
          <p class="hub-project-channel__desc">
            Rede, hardware, conectividade e acesso. Abra o chamado no Avadesk para atendimento presencial ou remoto.
          </p>
          <p class="hub-project-channel__foot">Abrir chamado no Avadesk</p>
        </article>

        <article class="hub-project-channel">
          <div class="hub-project-channel__icon" aria-hidden="true">
            <span class="material-symbols-outlined">support_agent</span>
          </div>
          <h3 class="hub-project-channel__title">Equipe de TI</h3>
          <p class="hub-project-channel__desc">
            Bugs, ajustes e dúvidas dos módulos Folha, Fiscal, Contábil e portal. Canal oficial no Avadesk.
          </p>
          <p class="hub-project-channel__foot">Canal no Avadesk</p>
        </article>

        <article class="hub-project-channel">
          <div class="hub-project-channel__icon" aria-hidden="true">
            <span class="material-symbols-outlined">add_chart</span>
          </div>
          <h3 class="hub-project-channel__title">Solicitação de novos módulos</h3>
          <p class="hub-project-channel__desc">
            Proposta de módulo, integração ou automação. Abra o chamado no Avadesk para a Equipe de TI.
          </p>
          <p class="hub-project-channel__foot">Abrir chamado no Avadesk</p>
        </article>
      </div>
    </section>
  </main>

  <%- include('partials/hub-chrome-end') %>
</body>
</html>

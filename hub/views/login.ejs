<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/hub-head') %>
</head>
<body class="hub-login-page">
  <main class="hub-login-card">
    <header class="hub-login-brand">
      <img src="/hub-assets/exito-hub-logo.svg" alt="" width="48" height="48" style="margin: 0 auto 0.75rem; display: block;" />
      <p class="hub-wordmark">Êxito</p>
      <p class="hub-kicker">HUB</p>
    </header>

    <% if (error) { %>
      <div class="hub-alert" role="alert"><%= error %></div>
    <% } %>

    <form method="post" action="/login" class="hub-form" autocomplete="on">
      <label class="hub-field">
        <span>Usuário ou e-mail</span>
        <input name="username" required autocomplete="username" placeholder="Usuário ou e-mail" value="<%= lastUsername || '' %>" />
      </label>
      <label class="hub-field">
        <span>Senha</span>
        <input name="password" type="password" required autocomplete="current-password" placeholder="••••••••" />
      </label>
      <button type="submit" class="hub-btn hub-btn-primary">
        Entrar
      </button>
    </form>
  </main>
</body>
</html>

# Porta única do EXITO HUB
PORT=3000
NODE_ENV=development
SESSION_SECRET=altere-esta-string-longa-e-aleatoria

# Banco do HUB (usuários e permissões de módulo)
HUB_DB_HOST=127.0.0.1
HUB_DB_PORT=5432
HUB_DB_USER=postgres
HUB_DB_PASSWORD=alterar
HUB_DB_NAME=exito_hub

# Seed do primeiro admin (só na 1ª subida; nunca commitar senha real)
HUB_SEED_ADMIN_USER=admin
HUB_SEED_ADMIN_EMAIL=escritorio@local
HUB_SEED_ADMIN_PASSWORD=alterar

# Folha (BeatrizDt) — banco separado
FOLHA_DB_HOST=127.0.0.1
FOLHA_DB_PORT=5432
FOLHA_DB_USER=postgres
FOLHA_DB_PASSWORD=alterar
FOLHA_DB_NAME=beatriz_impostos
FOLHA_STORAGE_BACKEND=postgres

# Conciliação — banco separado
CONCI_DB_HOST=127.0.0.1
CONCI_DB_PORT=5432
CONCI_DB_USER=postgres
CONCI_DB_PASSWORD=alterar
CONCI_DB_NAME=CONCI

# NCM / fiscal — banco separado
NCM_DB_HOST=127.0.0.1
NCM_DB_PORT=5432
NCM_DB_USER=postgres
NCM_DB_PASSWORD=alterar
NCM_DB_NAME=fiscal-p
NCM_DATABASE_URL=postgresql://postgres:alterar@localhost:5432/fiscal-p

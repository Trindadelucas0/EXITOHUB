# Copie para .env e preencha. Nunca commite o .env com senha real.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=fiscal-p
DB_USER=postgres
DB_PASSWORD=alterar

DATABASE_URL=postgresql://postgres:alterar@localhost:5432/fiscal-p

SESSION_SECRET=gerar-uma-string-longa-aleatoria
SEED_ADMIN_EMAIL=admin@baifer.local
SEED_ADMIN_PASSWORD=alterar
SEED_SUPERADMIN_EMAIL=escritorio@local
SEED_SUPERADMIN_PASSWORD=alterar
# Só use se quiser apagar lotes importados no seed:
# SEED_RESET_CADASTRO=1

# Em produção use HTTPS; cookie Secure liga automaticamente quando NODE_ENV=production
NODE_ENV=development

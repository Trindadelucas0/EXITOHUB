<%- include('partials/app-shell-start', {
  title: 'Bancos — Admin',
  currentNav: 'bancos',
  navMode: 'admin',
  headerEyebrow: 'Administrador',
  headerTitle: 'Bancos',
  mainClass: 'app-main'
}) %>

<% var listaEmpresas = (typeof empresas !== 'undefined' && empresas) ? empresas : []; %>

<div class="page-header">
  <h2>Bancos</h2>
  <p>Cadastre os bancos de cada empresa (nome, código de crédito e empresa). A empresa só vê os bancos ativos dela no upload e no pré-cadastro. Banco "Sem empresa" não aparece para ninguém até você escolher a empresa e salvar.</p>
</div>

<%- include('partials/flash') %>

<form method="post" action="<%= u('/admin/bancos') %>" class="card card-pad" style="margin-bottom: 1rem;">
  <h3 class="card-title">Novo banco</h3>
  <div style="display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); align-items: end;">
    <div>
      <label class="field-label" for="nome">Nome do banco</label>
      <input id="nome" name="nome" required placeholder="Ex.: ITAU" class="field-input" />
    </div>
    <div>
      <label class="field-label" for="codigoCredito">Código crédito</label>
      <input id="codigoCredito" name="codigoCredito" type="number" required placeholder="Ex.: 9" class="field-input" />
    </div>
    <div>
      <label class="field-label" for="empresaId">Empresa</label>
      <select id="empresaId" name="empresaId" required class="field-select">
        <option value="">Selecione a empresa…</option>
        <% listaEmpresas.forEach(function(e) { %>
          <option value="<%= e.id %>"><%= e.nome %><%= e.ativo === false ? ' (inativa)' : '' %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <button type="submit" class="btn btn-primary">Criar banco</button>
    </div>
  </div>
  <% if (!listaEmpresas.length) { %>
    <p class="field-hint" style="color: var(--warning); margin-top: 0.5rem;">
      Nenhuma empresa cadastrada. Crie a empresa em Empresas antes do banco.
    </p>
  <% } %>
</form>

<div class="card">
  <div style="padding: 0.85rem 1rem; border-bottom: 1px solid var(--border);">
    <h3 class="card-title" style="margin: 0;">Bancos cadastrados</h3>
  </div>
  <% if (!bancos.length) { %>
    <div class="empty-state">Nenhum banco ainda.</div>
  <% } %>
  <% bancos.forEach(function(b) { %>
    <div class="admin-row admin-row--banco">
      <form method="post" action="<%= u('/admin/bancos/' + b.id) %>" style="display: contents;">
        <div>
          <label class="field-label">Nome</label>
          <input name="nome" value="<%= b.nome %>" required class="field-input" />
        </div>
        <div>
          <label class="field-label">Código crédito</label>
          <input name="codigoCredito" type="number" value="<%= b.codigoCredito %>" required class="field-input" />
        </div>
        <div>
          <label class="field-label">Empresa</label>
          <select name="empresaId" required class="field-select">
            <% if (!b.empresaId) { %>
              <option value="" selected>Sem empresa — escolha</option>
            <% } %>
            <% listaEmpresas.forEach(function(e) { %>
              <option value="<%= e.id %>" <%= e.id === b.empresaId ? 'selected' : '' %>><%= e.nome %><%= e.ativo === false ? ' (inativa)' : '' %></option>
            <% }) %>
          </select>
        </div>
        <div class="admin-row-actions">
          <button type="submit" class="btn btn-primary btn-sm">Salvar</button>
          <span class="badge <%= b.ativo ? 'badge-enviado' : 'badge-pendente' %>"><%= b.ativo ? 'Ativo' : 'Inativo' %></span>
          <% if (!b.empresaId) { %>
            <span class="badge badge-pendente">Sem empresa</span>
          <% } %>
        </div>
      </form>
      <form method="post" action="<%= u('/admin/bancos/' + b.id) %>" style="grid-column: 1 / -1;">
        <input type="hidden" name="action" value="toggle" />
        <input type="hidden" name="ativo" value="<%= b.ativo ? 'true' : 'false' %>" />
        <button type="submit" class="btn btn-ghost btn-sm">
          <%= b.ativo ? 'Desativar' : 'Ativar' %>
        </button>
      </form>
    </div>
  <% }) %>
</div>

<%- include('partials/app-shell-end') %>

<%- include('partials/app-shell-start', {
  title: 'Bancos — Admin',
  currentNav: 'bancos',
  navMode: 'admin',
  headerEyebrow: 'Administrador',
  headerTitle: 'Bancos',
  mainClass: 'app-main'
}) %>

<div class="page-header">
  <h2>Bancos</h2>
  <p>Cadastre os bancos fixos do sistema (nome + código de crédito). A empresa só escolhe o banco no upload e no pré-cadastro.</p>
</div>

<%- include('partials/flash') %>

<form method="post" action="/admin/bancos" class="card card-pad" style="margin-bottom: 1rem;">
  <h3 class="card-title">Novo banco</h3>
  <div style="display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); align-items: end;">
    <div>
      <label class="field-label" for="nome">Nome do banco</label>
      <input id="nome" name="nome" required placeholder="Ex.: ITAU" class="field-input" />
    </div>
    <div>
      <label class="field-label" for="codigoCredito">Código crédito</label>
      <input id="codigoCredito" name="codigoCredito" type="number" required placeholder="Ex.: 9" class="field-input" />
    </div>
    <div>
      <button type="submit" class="btn btn-primary">Criar banco</button>
    </div>
  </div>
</form>

<div class="card">
  <div style="padding: 0.85rem 1rem; border-bottom: 1px solid var(--border);">
    <h3 class="card-title" style="margin: 0;">Bancos cadastrados</h3>
  </div>
  <% if (!bancos.length) { %>
    <div class="empty-state">Nenhum banco ainda.</div>
  <% } %>
  <% bancos.forEach(function(b) { %>
    <div class="admin-row admin-row--banco">
      <form method="post" action="/admin/bancos/<%= b.id %>" style="display: contents;">
        <div>
          <label class="field-label">Nome</label>
          <input name="nome" value="<%= b.nome %>" required class="field-input" />
        </div>
        <div>
          <label class="field-label">Código crédito</label>
          <input name="codigoCredito" type="number" value="<%= b.codigoCredito %>" required class="field-input" />
        </div>
        <div class="admin-row-actions">
          <button type="submit" class="btn btn-primary btn-sm">Salvar</button>
          <span class="badge <%= b.ativo ? 'badge-enviado' : 'badge-pendente' %>"><%= b.ativo ? 'Ativo' : 'Inativo' %></span>
        </div>
      </form>
      <form method="post" action="/admin/bancos/<%= b.id %>" style="grid-column: 1 / -1;">
        <input type="hidden" name="action" value="toggle" />
        <input type="hidden" name="ativo" value="<%= b.ativo ? 'true' : 'false' %>" />
        <button type="submit" class="btn btn-ghost btn-sm">
          <%= b.ativo ? 'Desativar' : 'Ativar' %>
        </button>
      </form>
    </div>
  <% }) %>
</div>

<%- include('partials/app-shell-end') %>

<%
  const hu = typeof hubUser !== 'undefined' ? hubUser : null;
%>
<% if (typeof hubMode !== 'undefined' && hubMode && hu) { %>
<header class="hub-chrome hub-chrome--exito">
  <div class="hub-chrome-inner">
    <%- include('hub-app-menu', { menuUser: hu, current: typeof current !== 'undefined' ? current : 'conci', showHomeLink: true }) %>
    <a href="/" class="hub-chrome-brand">
      <div>
        <p class="hub-eyebrow">Êxito</p>
        <strong>HUB</strong>
      </div>
    </a>
    <div class="hub-chrome-user">
      <a href="/" class="hub-nav-link hub-nav-btn">Início</a>
      <span class="hub-user-name"><%= hu.displayName || hu.username %></span>
      <form method="post" action="/logout" class="hub-inline">
        <button type="submit" class="hub-nav-link hub-nav-btn">Sair</button>
      </form>
    </div>
  </div>
</header>
<script src="/hub-assets/hub-menu.js"></script>
<% } %>
